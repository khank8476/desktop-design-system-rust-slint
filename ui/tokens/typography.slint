export global Typography {
    // High-DPI Native Desktop Font Stack
    out property <string> font-family: "Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Ubuntu, sans-serif";

    // Text Sizes (Calibrated for high readability on desktop)
    out property <length> size-xs: 13px;
    out property <length> size-sm: 15px;
    out property <length> size-base: 16px;
    out property <length> size-lg: 19px;
    out property <length> size-xl: 23px;
    out property <length> size-2xl: 28px;

    // Font Weights
    out property <int> weight-normal: 400;
    out property <int> weight-medium: 500;
    out property <int> weight-semibold: 600;
    out property <int> weight-bold: 700;
}
