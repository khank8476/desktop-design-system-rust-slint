import { Palette } from "../tokens/colors.slint";
import { Typography } from "../tokens/typography.slint";
import { Spacing } from "../tokens/spacing.slint";

export component Chip {
    in property <string> text: "Tag Item";
    in property <image> icon-image;
    in property <bool> has-icon: false;
    in property <bool> removable: false;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <string> variant: "default"; // "default" | "primary" | "success" | "warning" | "danger"

    callback clicked();
    callback removed();

    height: 28px;
    horizontal-stretch: 0;

    Rectangle {
        border-radius: Spacing.radius-full;
        border-width: 1px;
        border-color: root.selected ? Palette.accent :
                     root.variant == "primary" ? Palette.accent.with-alpha(0.5) :
                     root.variant == "success" ? Palette.success.with-alpha(0.5) :
                     root.variant == "warning" ? #f59e0b88 :
                     root.variant == "danger" ? Palette.danger.with-alpha(0.5) :
                     Palette.border-subtle;

        background: root.selected ? (Palette.accent.with-alpha(0.20)) :
                    body-touch.has-hover ? Palette.bg-surface-hover :
                    root.variant == "primary" ? (Palette.dark-mode ? #1e3a8a33 : #eff6ff) :
                    root.variant == "success" ? (Palette.dark-mode ? #064e3b33 : #ecfdf5) :
                    root.variant == "warning" ? (Palette.dark-mode ? #78350f33 : #fffbeb) :
                    root.variant == "danger"  ? (Palette.dark-mode ? #7f1d1d33 : #fef2f2) :
                    Palette.bg-surface;

        animate background { duration: 100ms; }
        animate border-color { duration: 100ms; }

        HorizontalLayout {
            padding-left: root.has-icon ? 8px : 12px;
            padding-right: root.removable ? 6px : 12px;
            spacing: 6px;
            alignment: center;

            // Clickable pill body: Icon + Label
            pill-body := Rectangle {
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;

                    // Vertically Centered Vector Icon Prefix
                    if root.has-icon: VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.icon-image;
                            width: 12px;
                            height: 12px;
                            colorize: root.selected ? Palette.accent :
                                      root.variant == "primary" ? Palette.accent :
                                      root.variant == "success" ? Palette.success :
                                      root.variant == "warning" ? #f59e0b :
                                      root.variant == "danger" ? Palette.danger :
                                      Palette.text-secondary;
                        }
                    }

                    // Vertically Centered Chip Label
                    Text {
                        text: root.text;
                        font-family: Typography.font-family;
                        font-size: Typography.size-xs;
                        font-weight: root.selected ? Typography.weight-semibold : Typography.weight-medium;
                        color: root.selected ? Palette.accent :
                               root.variant == "primary" ? Palette.accent :
                               root.variant == "success" ? Palette.success :
                               root.variant == "danger" ? Palette.danger :
                               Palette.text-primary;
                        vertical-alignment: center;
                    }
                }

                body-touch := TouchArea {
                    mouse-cursor: root.enabled ? pointer : default;
                    clicked => {
                        if root.enabled {
                            root.clicked();
                        }
                    }
                }
            }

            // Vertically Centered Dedicated Remove Button (✕)
            if root.removable: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    background: remove-touch.has-hover ? (Palette.dark-mode ? #475569 : #cbd5e1) : transparent;

                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../../assets/icons/close.svg");
                            width: 8px;
                            height: 8px;
                            colorize: Palette.text-secondary;
                            horizontal-alignment: center;
                        }
                    }

                    remove-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.removed();
                        }
                    }
                }
            }
        }
    }
}
