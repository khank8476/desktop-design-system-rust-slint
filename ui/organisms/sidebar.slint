import { Palette } from "../tokens/colors.slint";
import { Typography } from "../tokens/typography.slint";
import { Spacing } from "../tokens/spacing.slint";

export struct NavItemData {
    id: string,
    label: string,
    icon: string,
}

export component DesktopSidebar {
    in-out property <bool> collapsed: false;
    in-out property <int> active-index: 0;
    in property <[NavItemData]> nav-items: [
        { id: "showcase", label: "Component Library", icon: "❖" },
        { id: "feed", label: "Live Telemetry Feed", icon: "⚡" },
        { id: "tokens", label: "Design Tokens", icon: "🎨" },
        { id: "settings", label: "System Config", icon: "⚙" }
    ];

    callback nav-changed(int);
    callback toggle-collapse();

    width: root.collapsed ? 68px : 230px;
    animate width { duration: 180ms; easing: ease-out; }

    Rectangle {
        clip: true; // Keeps elements inside during width animation
        background: Palette.dark-mode ? #090d16 : #f1f5f9; // Distinct desktop sidebar surface
        border-width: 1px;
        border-color: Palette.border-subtle;

        VerticalLayout {
            padding: Spacing.space-md;
            spacing: Spacing.space-md;

            // 1. Sidebar Brand Header
            HorizontalLayout {
                spacing: Spacing.space-sm;
                alignment: start;

                Image {
                    source: @image-url("../../assets/app-icon.png");
                    width: 32px;
                    height: 32px;
                }

                if !root.collapsed: VerticalLayout {
                    alignment: center;
                    spacing: 0px;

                    Text {
                        text: "DesignSystem";
                        font-family: Typography.font-family;
                        font-size: Typography.size-base;
                        font-weight: Typography.weight-bold;
                        color: Palette.text-primary;
                    }
                    Text {
                        text: "v1.0 Native Rust";
                        font-family: Typography.font-family;
                        font-size: Typography.size-xs;
                        color: Palette.text-secondary;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Palette.border-subtle;
            }

            // 2. Navigation Items List
            VerticalLayout {
                spacing: 4px;
                vertical-stretch: 1;

                for item[idx] in root.nav-items: nav-btn := Rectangle {
                    height: 42px;
                    border-radius: Spacing.radius-md;
                    background: idx == root.active-index ? (Palette.dark-mode ? #1e293b : #ffffff) :
                                item-touch.has-hover ? (Palette.dark-mode ? #1e293b66 : #ffffff88) :
                                transparent;

                    // Subtle active indicator shadow
                    drop-shadow-blur: idx == root.active-index ? 6px : 0px;
                    drop-shadow-color: #00000022;
                    drop-shadow-offset-y: 1px;

                    animate background { duration: 120ms; }

                    HorizontalLayout {
                        padding-left: root.collapsed ? 0px : Spacing.space-md;
                        padding-right: root.collapsed ? 0px : Spacing.space-md;
                        spacing: Spacing.space-md;
                        alignment: root.collapsed ? center : start;

                        // Icon Glyph
                        Text {
                            text: item.icon;
                            font-size: Typography.size-base;
                            color: idx == root.active-index ? Palette.accent : Palette.text-secondary;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }

                        // Label (hidden smoothly when collapsed)
                        if !root.collapsed: Text {
                            text: item.label;
                            font-family: Typography.font-family;
                            font-size: Typography.size-base;
                            font-weight: idx == root.active-index ? Typography.weight-semibold : Typography.weight-normal;
                            color: idx == root.active-index ? Palette.text-primary : Palette.text-secondary;
                            vertical-alignment: center;
                        }
                    }

                    item-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.active-index = idx;
                            root.nav-changed(idx);
                        }
                    }
                }
            }

            // 3. Bottom Collapse Toggle Button
            Rectangle {
                height: 1px;
                background: Palette.border-subtle;
            }

            collapse-btn := Rectangle {
                height: 38px;
                border-radius: Spacing.radius-md;
                background: collapse-touch.has-hover ? Palette.bg-surface-hover : transparent;

                HorizontalLayout {
                    padding-left: root.collapsed ? 0px : Spacing.space-md;
                    padding-right: root.collapsed ? 0px : Spacing.space-md;
                    spacing: Spacing.space-md;
                    alignment: root.collapsed ? center : start;

                    Text {
                        text: root.collapsed ? "▶" : "◀";
                        font-size: Typography.size-sm;
                        color: Palette.text-secondary;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }

                    if !root.collapsed: Text {
                        text: "Collapse Sidebar";
                        font-family: Typography.font-family;
                        font-size: Typography.size-sm;
                        color: Palette.text-secondary;
                        vertical-alignment: center;
                    }
                }

                collapse-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.collapsed = !root.collapsed;
                        root.toggle-collapse();
                    }
                }
            }
        }
    }
}

