import { Palette } from "../tokens/colors.slint";
import { Typography } from "../tokens/typography.slint";
import { Spacing } from "../tokens/spacing.slint";
import { Button } from "../atoms/button.slint";

export component ModalDialog {
    in property <string> title: "Confirm Action";
    in property <string> message: "Are you sure you want to proceed? This change will be saved directly to your native configuration.";
    in property <string> confirm-text: "Confirm";
    in property <string> cancel-text: "Cancel";
    in property <string> confirm-variant: "primary"; // "primary" | "danger"
    in-out property <bool> is-open: false;

    callback confirmed();
    callback cancelled();

    if root.is-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000077; // Translucent dark scrim that dims background content

        // Backdrop click dismisses
        TouchArea {
            clicked => {
                root.is-open = false;
                root.cancelled();
            }
        }

        // Compact Native Dialog Card (100% Solid Opaque background + explicit height)
        card := Rectangle {
            width: 440px;
            height: card-layout.preferred-height;
            border-radius: Spacing.radius-lg;
            border-width: 1px;
            border-color: Palette.border-strong;
            background: Palette.dark-mode ? #1e293b : #ffffff; // 100% OPAQUE - no see-through!
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000099;
            drop-shadow-offset-y: 8px;

            // Absorbs clicks inside the dialog so it doesn't close on click
            TouchArea {}

            card-layout := VerticalLayout {
                padding: Spacing.space-lg;
                spacing: Spacing.space-md;

                // Titlebar Header
                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: Spacing.space-sm;
                        alignment: center;

                        // Small Accent Indicator Dot
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Palette.accent;
                        }

                        Text {
                            text: root.title;
                            font-family: Typography.font-family;
                            font-size: Typography.size-lg;
                            font-weight: Typography.weight-bold;
                            color: Palette.text-primary;
                            vertical-alignment: center;
                        }
                    }

                    // Native Vector Close Button
                    close-btn := Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: Spacing.radius-sm;
                        background: close-touch.has-hover ? Palette.bg-surface-hover : transparent;

                        Image {
                            source: @image-url("../../assets/icons/close.svg");
                            width: 14px;
                            height: 14px;
                            colorize: close-touch.has-hover ? Palette.text-primary : Palette.text-secondary;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.is-open = false;
                                root.cancelled();
                            }
                        }
                    }
                }

                // Divider line
                Rectangle {
                    height: 1px;
                    background: Palette.border-subtle;
                }

                // Body Message
                Text {
                    text: root.message;
                    font-family: Typography.font-family;
                    font-size: Typography.size-base;
                    color: Palette.text-secondary;
                    wrap: word-wrap;
                }

                // Action Footer
                HorizontalLayout {
                    alignment: end;
                    spacing: Spacing.space-sm;

                    Button {
                        text: root.cancel-text;
                        variant: "ghost";
                        clicked => {
                            root.is-open = false;
                            root.cancelled();
                        }
                    }

                    Button {
                        text: root.confirm-text;
                        variant: root.confirm-variant;
                        clicked => {
                            root.is-open = false;
                            root.confirmed();
                        }
                    }
                }
            }
        }
    }
}
