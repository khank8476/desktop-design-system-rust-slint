import { ScrollView } from "std-widgets.slint";
import { Palette } from "../tokens/colors.slint";
import { Typography } from "../tokens/typography.slint";
import { Spacing } from "../tokens/spacing.slint";

export struct CommandItem {
    id: string,
    title: string,
    category: string,
    shortcut: string,
    icon-text: string,
}

component PaletteRow {
    in property <CommandItem> item;
    in property <bool> is-selected: false;
    callback clicked();

    height: 44px;

    Rectangle {
        border-radius: Spacing.radius-md;
        background: root.is-selected ? (Palette.accent.with-alpha(0.15)) :
                    row-touch.has-hover ? Palette.bg-surface-hover : transparent;
        border-width: root.is-selected ? 1px : 0px;
        border-color: Palette.accent;

        HorizontalLayout {
            padding-left: Spacing.space-md;
            padding-right: Spacing.space-md;
            spacing: Spacing.space-md;
            alignment: space-between;

            // Icon + Title + Category
            HorizontalLayout {
                spacing: Spacing.space-sm;
                alignment: center;

                // Icon Box
                Rectangle {
                    width: 28px;
                    height: 28px;
                    border-radius: Spacing.radius-sm;
                    background: Palette.dark-mode ? #0f172a : #f1f5f9;

                    Text {
                        text: root.item.icon-text;
                        font-size: 13px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 1px;

                    Text {
                        text: root.item.title;
                        font-family: Typography.font-family;
                        font-size: Typography.size-sm;
                        font-weight: Typography.weight-semibold;
                        color: root.is-selected ? Palette.accent : Palette.text-primary;
                    }

                    Text {
                        text: root.item.category;
                        font-family: Typography.font-family;
                        font-size: 10px;
                        color: Palette.text-secondary;
                    }
                }
            }

            // Keyboard Shortcut Badge
            if root.item.shortcut != "": HorizontalLayout {
                alignment: center;

                Rectangle {
                    height: 22px;
                    border-radius: Spacing.radius-sm;
                    background: Palette.dark-mode ? #0f172a : #f1f5f9;
                    border-width: 1px;
                    border-color: Palette.border-subtle;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        alignment: center;

                        Text {
                            text: root.item.shortcut;
                            font-family: "Consolas, monospace";
                            font-size: 10px;
                            color: Palette.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        row-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

export component CommandPalette {
    in-out property <bool> is-open: false;
    in-out property <string> search-query: "";
    in property <[CommandItem]> commands: [
        { id: "toggle-theme", title: "Toggle Dark / Light Theme", category: "Preferences", shortcut: "Ctrl+T", icon-text: "🌓" },
        { id: "open-pos", title: "Launch POS Retail Terminal", category: "Examples", shortcut: "F8", icon-text: "🛒" },
        { id: "open-devforge", title: "Launch DevForge Developer Studio", category: "Examples", shortcut: "F9", icon-text: "⚡" },
        { id: "open-treeview", title: "Scan Local Workspace Filesystem", category: "Explorer", shortcut: "Ctrl+E", icon-text: "📁" },
        { id: "refresh-telemetry", title: "Refresh 360° Hardware Telemetry", category: "System", shortcut: "F5", icon-text: "🖥️" },
        { id: "create-shortcut", title: "Create Native Desktop Shortcut", category: "System", shortcut: "", icon-text: "🔗" },
    ];

    callback command-selected(string);
    callback closed();

    if root.is-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #00000077; // Backdrop overlay

        backdrop-touch := TouchArea {
            clicked => {
                root.is-open = false;
                root.closed();
            }
        }

        // Floating Centered Command Box
        card := Rectangle {
            width: 580px;
            max-height: 420px;
            border-radius: Spacing.radius-lg;
            border-width: 1px;
            border-color: Palette.border-focus;
            background: Palette.bg-surface;
            drop-shadow-blur: 32px;
            drop-shadow-color: #00000088;
            drop-shadow-offset-y: 8px;

            // Centered on screen
            x: (parent.width - self.width) / 2;
            y: parent.height * 0.15;

            VerticalLayout {
                padding: Spacing.space-md;
                spacing: Spacing.space-sm;

                // Search Bar Input
                Rectangle {
                    height: 44px;
                    border-radius: Spacing.radius-md;
                    border-width: 1.5px;
                    border-color: Palette.border-subtle;
                    background: Palette.dark-mode ? #0f172a : #f8fafc;

                    HorizontalLayout {
                        padding-left: Spacing.space-md;
                        padding-right: Spacing.space-md;
                        spacing: Spacing.space-sm;
                        alignment: center;

                        Text {
                            text: "🔍";
                            font-size: 14px;
                            vertical-alignment: center;
                        }

                        search-input := TextInput {
                            width: 100%;
                            text <=> root.search-query;
                            font-family: Typography.font-family;
                            font-size: Typography.size-base;
                            color: Palette.text-primary;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            height: 20px;
                            border-radius: Spacing.radius-sm;
                            background: Palette.dark-mode ? #1e293b : #e2e8f0;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: center;

                                Text {
                                    text: "ESC to close";
                                    font-size: 10px;
                                    color: Palette.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Divider
                Rectangle {
                    height: 1px;
                    background: Palette.border-subtle;
                }

                // Command List
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 4px;

                        for item in root.commands: PaletteRow {
                            item: item;
                            clicked => {
                                root.command-selected(item.id);
                                root.is-open = false;
                                root.closed();
                            }
                        }
                    }
                }
            }
        }
    }
}

