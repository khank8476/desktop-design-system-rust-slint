import { ScrollView } from "std-widgets.slint";
import { Palette } from "../tokens/colors.slint";
import { Typography } from "../tokens/typography.slint";
import { Spacing } from "../tokens/spacing.slint";

export struct CommandItem {
    id: string,
    title: string,
    category: string,
    shortcut: string,
    icon: string,
}

component PaletteRow {
    in property <CommandItem> item;
    in property <bool> is-selected: false;
    callback clicked();

    height: 48px;

    Rectangle {
        border-radius: Spacing.radius-md;
        background: root.is-selected ? (Palette.accent.with-alpha(0.15)) :
                    row-touch.has-hover ? Palette.bg-surface-hover : transparent;
        border-width: root.is-selected ? 1px : 0px;
        border-color: Palette.accent;

        HorizontalLayout {
            padding-left: Spacing.space-md;
            padding-right: Spacing.space-md;
            spacing: Spacing.space-md;

            // Left Section: Icon Box + Title + Category
            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: Spacing.space-md;

                // 32x32px Icon Box (Vertically Centered in 48px Row)
                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: Spacing.radius-sm;
                        background: Palette.bg-subtle;
                        border-width: 1px;
                        border-color: Palette.border-subtle;

                        // Vector SVG Icon is 100% centered in both X and Y
                        Image {
                            source: root.item.icon == "theme" ? @image-url("../../assets/icons/sun-moon.svg") :
                                    root.item.icon == "pos" ? @image-url("../../assets/icons/cart.svg") :
                                    root.item.icon == "devforge" ? @image-url("../../assets/icons/zap.svg") :
                                    root.item.icon == "explorer" ? @image-url("../../assets/icons/folder.svg") :
                                    root.item.icon == "telemetry" ? @image-url("../../assets/icons/cpu.svg") :
                                    root.item.icon == "shortcut" ? @image-url("../../assets/icons/link.svg") :
                                    @image-url("../../assets/icons/settings.svg");
                            width: 16px;
                            height: 16px;
                            colorize: root.is-selected ? Palette.accent : Palette.text-secondary;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                // Text Block (Vertically Centered in 48px Row)
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    Text {
                        text: root.item.title;
                        font-family: Typography.font-family;
                        font-size: Typography.size-sm;
                        font-weight: Typography.weight-semibold;
                        color: root.is-selected ? Palette.accent : Palette.text-primary;
                    }

                    Text {
                        text: root.item.category;
                        font-family: Typography.font-family;
                        font-size: 10px;
                        color: Palette.text-secondary;
                    }
                }
            }

            // Right Section: Shortcut Badge (Vertically Centered in 48px Row)
            if root.item.shortcut != "": VerticalLayout {
                alignment: center;

                Rectangle {
                    height: 22px;
                    border-radius: Spacing.radius-sm;
                    background: Palette.bg-subtle;
                    border-width: 1px;
                    border-color: Palette.border-subtle;

                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        alignment: center;

                        Text {
                            text: root.item.shortcut;
                            font-family: "Consolas, monospace";
                            font-size: 10px;
                            font-weight: Typography.weight-medium;
                            color: Palette.text-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        row-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.clicked(); }
        }
    }
}

export component CommandPalette {
    in-out property <bool> is-open: false;
    in-out property <string> search-query: "";
    in property <[CommandItem]> commands: [
        { id: "toggle-theme", title: "Toggle Dark / Light Theme", category: "Preferences", shortcut: "Ctrl+T", icon: "theme" },
        { id: "open-pos", title: "Launch POS Retail Terminal", category: "Examples", shortcut: "F8", icon: "pos" },
        { id: "open-devforge", title: "Launch DevForge Developer Studio", category: "Examples", shortcut: "F9", icon: "devforge" },
        { id: "open-treeview", title: "Scan Local Workspace Filesystem", category: "Explorer", shortcut: "Ctrl+E", icon: "explorer" },
        { id: "refresh-telemetry", title: "Refresh 360° Hardware Telemetry", category: "System", shortcut: "F5", icon: "telemetry" },
        { id: "create-shortcut", title: "Create Native Desktop Shortcut", category: "System", shortcut: "", icon: "shortcut" },
    ];

    callback command-selected(string);
    callback search-changed(string);
    callback closed();

    width: 100%;
    height: 100%;

    if root.is-open: FocusScope {
        width: 100%;
        height: 100%;
        forward-focus: search-input;

        key-pressed(event) => {
            if event.text == Key.Escape {
                root.is-open = false;
                root.closed();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: 100%;
            height: 100%;
            background: #000000bb; // High-contrast solid dark backdrop

            // Click outside the modal card to dismiss
            backdrop-touch := TouchArea {
                clicked => {
                    root.is-open = false;
                    root.closed();
                }
            }

            // Floating Centered Command Box (100% Solid & Opaque, Centered Like Modal)
            card := Rectangle {
                width: 620px;
                height: 400px;
                border-radius: Spacing.radius-lg;
                border-width: 1.5px;
                border-color: Palette.accent;
                background: Palette.bg-surface;
                drop-shadow-blur: 32px;
                drop-shadow-color: #000000dd;
                drop-shadow-offset-y: 8px;

                // Centered exactly in the middle of the window
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;

                // Absorbs clicks inside card so backdrop-touch does not close
                card-touch := TouchArea {
                    // Prevent falling through to backdrop
                }

                VerticalLayout {
                    padding: Spacing.space-md;
                    spacing: Spacing.space-sm;

                    // Full-Width Search Bar Header (Height 48px)
                    Rectangle {
                        height: 48px;
                        border-radius: Spacing.radius-md;
                        border-width: 1.5px;
                        border-color: Palette.border-subtle;
                        background: Palette.bg-input;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 10px;
                            spacing: 10px;

                            // Left: Search Icon (Vertically Centered)
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../../assets/icons/search.svg");
                                    width: 16px;
                                    height: 16px;
                                    colorize: Palette.text-secondary;
                                }
                            }

                            // Middle: Wide Search Text Input
                            search-input := TextInput {
                                horizontal-stretch: 1;
                                text <=> root.search-query;
                                font-family: Typography.font-family;
                                font-size: Typography.size-base;
                                color: Palette.text-primary;
                                vertical-alignment: center;

                                edited => {
                                    root.search-changed(self.text);
                                }

                                key-pressed(event) => {
                                    if event.text == Key.Escape {
                                        root.is-open = false;
                                        root.closed();
                                        return accept;
                                    }
                                    if event.modifiers.control && (event.text == "t" || event.text == "T") {
                                        root.command-selected("toggle-theme");
                                        root.is-open = false;
                                        root.closed();
                                        return accept;
                                    }
                                    if event.text == Key.Return {
                                        if root.commands.length > 0 {
                                            root.command-selected(root.commands[0].id);
                                            root.is-open = false;
                                            root.closed();
                                            return accept;
                                        }
                                    }
                                    return reject;
                                }
                            }

                            // Right Controls: ESC Badge + Cancel (✕) Button
                            HorizontalLayout {
                                spacing: 6px;

                                // Vertically Centered ESC Badge
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 22px;
                                        border-radius: Spacing.radius-sm;
                                        background: Palette.bg-subtle;
                                        border-width: 1px;
                                        border-color: Palette.border-subtle;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;

                                            Text {
                                                text: "ESC to close";
                                                font-family: Typography.font-family;
                                                font-size: 10px;
                                                color: Palette.text-secondary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                // Vertically Centered Close (✕) Button
                                VerticalLayout {
                                    alignment: center;
                                    close-btn := Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: Spacing.radius-sm;
                                        background: close-palette-touch.has-hover ? Palette.bg-surface-hover : transparent;

                                        Image {
                                            source: @image-url("../../assets/icons/close.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: close-palette-touch.has-hover ? Palette.text-primary : Palette.text-secondary;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        close-palette-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.is-open = false;
                                                root.closed();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Divider
                    Rectangle {
                        height: 1px;
                        background: Palette.border-subtle;
                    }

                    // Command List with Empty State Support
                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 4px;

                            for item in root.commands: PaletteRow {
                                item: item;
                                clicked => {
                                    root.command-selected(item.id);
                                    root.is-open = false;
                                    root.closed();
                                }
                            }

                            // Empty Search State
                            if root.commands.length == 0: VerticalLayout {
                                alignment: center;
                                padding: 36px;
                                spacing: 8px;

                                Text {
                                    text: "No matching commands found";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-sm;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "Try searching for 'theme', 'pos', 'devforge', 'explorer', or 'system'";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-placeholder;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
