import { Palette } from "../tokens/colors.slint";
import { Typography } from "../tokens/typography.slint";
import { Spacing } from "../tokens/spacing.slint";

export component TextInputField {
    in property <string> placeholder: "Type here...";
    in-out property <string> text <=> input.text;
    in property <bool> enabled: true;
    in property <InputType> input-type: InputType.text;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted();

    min-height: 40px;
    min-width: 0px;
    preferred-width: 160px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    forward-focus: input;

    Rectangle {
        clip: true;
        border-radius: Spacing.radius-md;
        border-width: input.has-focus ? 2px : 1px;
        border-color: input.has-focus ? Palette.border-focus : Palette.border-subtle;
        background: Palette.bg-surface;

        animate border-color { duration: 100ms; }

        text-viewport := Rectangle {
            x: Spacing.space-md;
            width: parent.width - (Spacing.space-md * 2);
            height: parent.height;
            clip: true;

            // In-frame Placeholder Text (fades out when user types or focuses)
            if input.text == "" && !input.has-focus: Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                font-family: Typography.font-family;
                font-size: Typography.size-base;
                color: Palette.text-placeholder;
                vertical-alignment: center;
                overflow: elide;
            }

            input := TextInput {
                property <length> computed-x: 0px;

                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                width: max(parent.width - self.text-cursor-width, self.preferred-width);
                height: 100%;
                vertical-alignment: center;
                single-line: true;
                enabled: root.enabled;
                input-type: root.input-type;
                font-family: Typography.font-family;
                font-size: Typography.size-base;
                color: Palette.text-primary;

                cursor-position-changed(cursor-position) => {
                    if cursor-position.x + self.computed-x < 0px {
                        self.computed-x = - cursor-position.x;
                    } else if cursor-position.x + self.computed-x > parent.width - self.text-cursor-width {
                        self.computed-x = parent.width - cursor-position.x - self.text-cursor-width;
                    }
                }

                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
        }
    }
}
