import { ScrollView } from "std-widgets.slint";
import { Palette } from "tokens/colors.slint";
import { Typography } from "tokens/typography.slint";
import { Spacing } from "tokens/spacing.slint";
import { Button } from "atoms/button.slint";
import { TextInputField } from "atoms/input.slint";
import { ToggleSwitch } from "atoms/toggle.slint";
import { Checkbox } from "atoms/checkbox.slint";
import { Badge } from "atoms/badge.slint";
import { ProgressBar } from "atoms/progressbar.slint";
import { Slider } from "atoms/slider.slint";
import { RadioButton } from "atoms/radio.slint";
import { Spinner } from "atoms/spinner.slint";
import { Stepper } from "atoms/stepper.slint";
import { AccordionItem } from "molecules/accordion.slint";
import { Alert } from "molecules/alert.slint";
import { SegmentedTabs } from "molecules/tabs.slint";
import { Tooltip } from "molecules/tooltip.slint";
import { ModalDialog } from "organisms/modal.slint";
import { Dropdown } from "organisms/dropdown.slint";
import { LiveFeedView, FeedItem } from "organisms/feed.slint";
import { DesktopSidebar } from "organisms/sidebar.slint";
import { ToastNotification } from "organisms/toast.slint";

export { Palette, FeedItem }

export component AppWindow inherits Window {
    title: "Native Desktop Design System";
    icon: @image-url("../assets/app-icon.png");
    min-width: 960px;
    min-height: 680px;
    preferred-width: 1080px;
    preferred-height: 760px;
    background: Palette.bg-canvas;

    in-out property <bool> show-modal: false;
    in-out property <int> selected-tab: 0;

    // Tier 1 Interactive Demo Properties
    in-out property <float> demo-slider-val: 72.0;
    in-out property <bool> demo-chk-1: true;
    in-out property <bool> demo-chk-2: false;
    in-out property <bool> demo-chk-3: false;
    in-out property <bool> demo-indeterminate: true;

    // Tier 2 Interactive Demo Properties
    in-out property <int> demo-radio-sel: 0;
    in-out property <int> demo-stepper-val: 16;
    in-out property <bool> demo-tooltip-hover: false;

    // Live Feed properties & callbacks
    in-out property <[FeedItem]> live-feed-items: [];
    in-out property <bool> is-feed-paused: true;
    callback toggle-feed-pause();
    callback clear-feed();

    // Toast Notification properties & callbacks
    in-out property <bool> toast-open: false;
    in-out property <string> toast-title: "Settings Saved";
    in-out property <string> toast-message: "Native preferences updated successfully.";
    in-out property <string> toast-status: "success";
    callback trigger-sample-toast(string, string, string); // (status, title, message)

    // Master Desktop Layout: Sidebar on Left + Content on Right
    HorizontalLayout {
        // 1. Collapsible Desktop Sidebar
        sidebar := DesktopSidebar {
            active-index <=> root.selected-tab;
        }

        // 2. Main Application Workspace
        VerticalLayout {
            horizontal-stretch: 1;

            // Top Header Bar (Clean, decluttered)
            Rectangle {
                height: 64px;
                background: Palette.bg-surface;
                border-width: 1px;
                border-color: Palette.border-subtle;

                HorizontalLayout {
                    padding-left: Spacing.space-xl;
                    padding-right: Spacing.space-xl;
                    alignment: start;

                    // Active Section Title & Breadcrumb
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: root.selected-tab == 0 ? "Component Library" :
                                  root.selected-tab == 1 ? "Live Telemetry" :
                                  root.selected-tab == 2 ? "Design Tokens" :
                                  "System Configuration";
                            font-family: Typography.font-family;
                            font-size: Typography.size-xl;
                            font-weight: Typography.weight-bold;
                            color: Palette.text-primary;
                        }
                        Text {
                            text: "Pure Native Rust • 120 FPS GPU Engine • Multi-platform";
                            font-family: Typography.font-family;
                            font-size: Typography.size-xs;
                            color: Palette.text-secondary;
                        }
                    }
                }
            }

            // Scrollable Active View Surface
            ScrollView {
                VerticalLayout {
                    padding: Spacing.space-xl;
                    spacing: Spacing.space-lg;

                    // Segmented Tabs Bar
                    SegmentedTabs {
                        tabs: ["Components", "Live Feed", "Design Tokens", "System"];
                        active-tab <=> root.selected-tab;
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.border-subtle;
                    }

                    // ==========================================
                    // TAB 0: COMPONENTS SHOWCASE (Spacious, Uncluttered Desktop Layout)
                    // ==========================================
                    if root.selected-tab == 0: VerticalLayout {
                        spacing: 36px; // Generous vertical breathing room

                        // 1. Desktop Organisms Showcase
                        VerticalLayout {
                            spacing: Spacing.space-md;

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Desktop Organisms";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Top-level composite window dialogs, floating toasts, and opaque dropdowns.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }
                            }

                            // Row 1: Modal + Dropdown
                            HorizontalLayout {
                                spacing: Spacing.space-md;
                                alignment: start;

                                Button {
                                    text: "Launch Modal Dialog";
                                    variant: "primary";
                                    clicked => {
                                        root.show-modal = true;
                                    }
                                }

                                Dropdown {
                                    width: 260px;
                                    placeholder: "Select Density Profile...";
                                }
                            }

                            // Row 2: Toast Notification Triggers
                            HorizontalLayout {
                                spacing: Spacing.space-md;
                                alignment: start;

                                Button {
                                    text: "Trigger Success Toast";
                                    variant: "secondary";
                                    clicked => {
                                        root.trigger-sample-toast("success", "Build Succeeded", "Native Rust binary optimized and signed.");
                                    }
                                }

                                Button {
                                    text: "Trigger Warning Toast";
                                    variant: "danger";
                                    clicked => {
                                        root.trigger-sample-toast("danger", "Process Warning", "Hardware GPU buffer spike detected.");
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Palette.border-subtle; }

                        // 2. Tier 1: Sliders & Progress Indicators (Interactive)
                        VerticalLayout {
                            spacing: Spacing.space-md;

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Sliders & Progress Controls (Tier 1 Atoms)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Drag the slider thumb to dynamically update the progress bar in real-time.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }
                            }

                            // Slider driving ProgressBar
                            VerticalLayout {
                                spacing: Spacing.space-sm;

                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "GPU Memory Buffer Allocation";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-sm;
                                        font-weight: Typography.weight-medium;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: Math.round(root.demo-slider-val) + "% Allocated";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-sm;
                                        color: Palette.accent;
                                        font-weight: Typography.weight-semibold;
                                    }
                                }

                                Slider {
                                    value <=> root.demo-slider-val;
                                    minimum: 0.0;
                                    maximum: 100.0;
                                    show-value: false;
                                }

                                ProgressBar {
                                    progress: root.demo-slider-val / 100.0;
                                    bar-height: 8px;
                                    variant: root.demo-slider-val > 85.0 ? "danger" : "primary";
                                }
                            }

                            // Secondary Success Progress Bar
                            VerticalLayout {
                                spacing: Spacing.space-xs;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "Shader Compilation Pipeline";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-xs;
                                        color: Palette.text-secondary;
                                    }
                                    Text {
                                        text: "100% Completed";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-xs;
                                        color: Palette.success;
                                        font-weight: Typography.weight-semibold;
                                    }
                                }

                                ProgressBar {
                                    progress: 1.0;
                                    bar-height: 6px;
                                    variant: "success";
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Palette.border-subtle; }

                        // 3. Tier 1: Checkboxes & Selection Controls
                        VerticalLayout {
                            spacing: Spacing.space-md;

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Checkboxes & Selection (Tier 1 Atoms)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Accessible desktop checkbox states: checked, unchecked, indeterminate, and disabled.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }
                            }

                            HorizontalLayout {
                                spacing: Spacing.space-xl;
                                alignment: start;

                                VerticalLayout {
                                    spacing: Spacing.space-sm;
                                    Checkbox {
                                        text: "Hardware Direct3D/Metal acceleration";
                                        checked <=> root.demo-chk-1;
                                    }
                                    Checkbox {
                                        text: "Subpixel antialiasing & LCD font smoothing";
                                        checked <=> root.demo-chk-2;
                                    }
                                }

                                VerticalLayout {
                                    spacing: Spacing.space-sm;
                                    Checkbox {
                                        text: "Batch compile multi-target distribution";
                                        indeterminate <=> root.demo-indeterminate;
                                    }
                                    Checkbox {
                                        text: "Software legacy rasterizer (Deprecated)";
                                        enabled: false;
                                        checked: false;
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Palette.border-subtle; }

                        // 4. Tier 1: Status Badges & Indicators
                        VerticalLayout {
                            spacing: Spacing.space-md;

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Status Badges & Pills (Tier 1 Atoms)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Compact high-contrast pills with live colored status dots and theme-aware tints.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }
                            }

                            HorizontalLayout {
                                spacing: Spacing.space-md;
                                alignment: start;

                                Badge {
                                    text: "Engine Active";
                                    variant: "success";
                                    has-dot: true;
                                }

                                Badge {
                                    text: "Rust v1.9 Native";
                                    variant: "primary";
                                    has-dot: true;
                                }

                                Badge {
                                    text: "LTO Strip Active";
                                    variant: "warning";
                                    has-dot: true;
                                }

                                Badge {
                                    text: "Buffer Spike";
                                    variant: "danger";
                                    has-dot: true;
                                }

                                Badge {
                                    text: "Zero Web Overhead";
                                    variant: "neutral";
                                    has-dot: false;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Palette.border-subtle; }

                        // 5. Tier 2: Radio Groups & Mutually Exclusive Choices
                        VerticalLayout {
                            spacing: Spacing.space-md;

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Radio Selection & Options (Tier 2 Atoms)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Accessible mutually exclusive selection with primary and secondary description text.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }
                            }

                            VerticalLayout {
                                spacing: Spacing.space-sm;

                                RadioButton {
                                    text: "DirectX 12 / Metal Hardware Pipeline";
                                    description: "Maximum GPU throughput at 120 FPS native refresh rate.";
                                    checked: root.demo-radio-sel == 0;
                                    toggled => { root.demo-radio-sel = 0; }
                                }

                                RadioButton {
                                    text: "Vulkan Cross-Platform Graphics";
                                    description: "Unified shading engine optimized for multi-vendor desktop GPUs.";
                                    checked: root.demo-radio-sel == 1;
                                    toggled => { root.demo-radio-sel = 1; }
                                }

                                RadioButton {
                                    text: "Low-Power Headless Software Rasterizer";
                                    description: "Fallback CPU execution for background automation environments.";
                                    checked: root.demo-radio-sel == 2;
                                    toggled => { root.demo-radio-sel = 2; }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Palette.border-subtle; }

                        // 6. Tier 2: Steppers, Spinners & Tooltip Hints
                        VerticalLayout {
                            spacing: Spacing.space-md;

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: "Numeric Steppers, Spinners & Tooltips (Tier 2)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Precision value inputs, async activity spinners, and floating contextual hints.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }
                            }

                            // Row 1: Stepper & Background Spinner (Clean responsive layout)
                            HorizontalLayout {
                                spacing: Spacing.space-xl;
                                alignment: start;

                                // Stepper Control with unit
                                VerticalLayout {
                                    spacing: Spacing.space-xs;
                                    Text {
                                        text: "Typography Base Scale";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-sm;
                                        color: Palette.text-primary;
                                        font-weight: Typography.weight-medium;
                                    }
                                    Stepper {
                                        value <=> root.demo-stepper-val;
                                        minimum: 8;
                                        maximum: 48;
                                        step: 2;
                                        unit: "px";
                                    }
                                }

                                // Async Rotating Spinner with text
                                VerticalLayout {
                                    spacing: Spacing.space-xs;
                                    Text {
                                        text: "Background Compiler Status";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-sm;
                                        color: Palette.text-primary;
                                        font-weight: Typography.weight-medium;
                                    }
                                    HorizontalLayout {
                                        spacing: Spacing.space-sm;
                                        alignment: start;
                                        Spinner {
                                            size: 22px;
                                            spinner-color: Palette.accent;
                                        }
                                        Text {
                                            text: "JIT Shaders compiling in background...";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-xs;
                                            color: Palette.text-secondary;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Row 2: Contextual Tooltip Popover (Moved below for perfect responsiveness)
                            VerticalLayout {
                                spacing: Spacing.space-xs;
                                Text {
                                    text: "Contextual Hint Popover (Desktop Tooltip)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-sm;
                                    color: Palette.text-primary;
                                    font-weight: Typography.weight-medium;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-md;
                                    alignment: start;

                                    tip-card := Rectangle {
                                        width: 140px;
                                        height: 38px;
                                        border-radius: Spacing.radius-md;
                                        border-width: 1.5px;
                                        border-color: tip-touch.has-hover ? Palette.accent : Palette.border-strong;
                                        background: tip-touch.has-hover ? Palette.bg-surface-hover : Palette.bg-surface;

                                        Text {
                                            text: "Hover For Hint";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-sm;
                                            font-weight: Typography.weight-medium;
                                            color: Palette.text-primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        tip-touch := TouchArea {
                                            mouse-cursor: pointer;
                                        }
                                    }

                                    Tooltip {
                                        text: "Direct GPU vector pipeline verified!";
                                        is-visible: tip-touch.has-hover;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Palette.border-subtle; }

                        // 7. Molecules: Alerts
                        VerticalLayout {
                            spacing: Spacing.space-sm;
                            Text {
                                text: "Alerts & Notifications (Molecules)";
                                font-family: Typography.font-family;
                                font-size: Typography.size-lg;
                                font-weight: Typography.weight-semibold;
                                color: Palette.text-primary;
                            }

                            Alert {
                                status: "info";
                                title: "Native Direct GPU Pipeline";
                                message: "All native components are dynamically rendered via GPU with zero web overhead.";
                            }
                        }

                        Rectangle { height: 1px; background: Palette.border-subtle; }

                        // 6. Molecules: Accordions
                        VerticalLayout {
                            spacing: Spacing.space-sm;
                            Text {
                                text: "Accordion Panels (Molecules)";
                                font-family: Typography.font-family;
                                font-size: Typography.size-lg;
                                font-weight: Typography.weight-semibold;
                                color: Palette.text-primary;
                            }

                            VerticalLayout {
                                spacing: Spacing.space-sm;

                                AccordionItem {
                                    title: "Why is hardware-accelerated desktop rendering faster?";
                                    description: "Unlike Electron which boots an entire Chromium browser engine and NodeJS runtime (eating 400MB+ RAM), this design system compiles directly to native instructions and paints onto DirectX/Metal/Vulkan surfaces.";
                                    expanded: true;
                                }

                                AccordionItem {
                                    title: "How does the auto theme detection work?";
                                    description: "The Rust backend queries the native operating system's theme registry. When your OS switches to dark or light mode, Slint's reactive palette instantly cascades the change to all atomic and molecule components.";
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Palette.border-subtle; }

                        // 7. Atoms: Buttons
                        VerticalLayout {
                            spacing: Spacing.space-sm;
                            Text {
                                text: "Buttons & Actions (Atoms)";
                                font-family: Typography.font-family;
                                font-size: Typography.size-lg;
                                font-weight: Typography.weight-semibold;
                                color: Palette.text-primary;
                            }

                            HorizontalLayout {
                                spacing: Spacing.space-md;
                                Button { text: "Primary Action"; variant: "primary"; }
                                Button { text: "Secondary"; variant: "secondary"; }
                                Button { text: "Ghost Action"; variant: "ghost"; }
                            }

                            HorizontalLayout {
                                spacing: Spacing.space-md;
                                Button { text: "Destructive Action"; variant: "danger"; }
                                Button { text: "Disabled Action"; enabled: false; }
                            }
                        }

                        Rectangle { height: 1px; background: Palette.border-subtle; }

                        // 8. Atoms: Inputs & Form Fields
                        VerticalLayout {
                            spacing: Spacing.space-sm;
                            Text {
                                text: "Inputs & Form Fields (Atoms)";
                                font-family: Typography.font-family;
                                font-size: Typography.size-lg;
                                font-weight: Typography.weight-semibold;
                                color: Palette.text-primary;
                            }

                            TextInputField {
                                placeholder: "Search components or documentation...";
                            }
                            TextInputField {
                                placeholder: "Enter secret credentials...";
                                input-type: InputType.password;
                            }
                        }
                    }

                    // ==========================================
                    // TAB 1: LIVE FEED SYSTEM
                    // ==========================================
                    if root.selected-tab == 1: VerticalLayout {
                        spacing: Spacing.space-md;

                        LiveFeedView {
                            items: root.live-feed-items;
                            is-paused: root.is-feed-paused;
                            toggle-pause => { root.toggle-feed-pause(); }
                            clear-feed => { root.clear-feed(); }
                        }
                    }

                    // ==========================================
                    // TAB 2: DESIGN TOKENS EXPLORER (Full Restoration)
                    // ==========================================
                    if root.selected-tab == 2: VerticalLayout {
                        spacing: Spacing.space-lg;

                        Text {
                            text: "Color Palette Tokens";
                            font-family: Typography.font-family;
                            font-size: Typography.size-lg;
                            font-weight: Typography.weight-semibold;
                            color: Palette.text-primary;
                        }

                        // Color Swatches Grid
                        HorizontalLayout {
                            spacing: Spacing.space-md;

                            Rectangle {
                                height: 90px;
                                border-radius: Spacing.radius-md;
                                border-width: 1px;
                                border-color: Palette.border-strong;
                                background: Palette.bg-canvas;
                                VerticalLayout {
                                    padding: Spacing.space-sm;
                                    alignment: space-between;
                                    Text { text: "bg-canvas"; font-size: Typography.size-sm; color: Palette.text-primary; font-weight: Typography.weight-bold; }
                                    Text { text: Palette.dark-mode ? "#0F172A" : "#F8FAFC"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                }
                            }

                            Rectangle {
                                height: 90px;
                                border-radius: Spacing.radius-md;
                                border-width: 1px;
                                border-color: Palette.border-strong;
                                background: Palette.bg-surface;
                                VerticalLayout {
                                    padding: Spacing.space-sm;
                                    alignment: space-between;
                                    Text { text: "bg-surface"; font-size: Typography.size-sm; color: Palette.text-primary; font-weight: Typography.weight-bold; }
                                    Text { text: Palette.dark-mode ? "#1E293B" : "#FFFFFF"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                }
                            }

                            Rectangle {
                                height: 90px;
                                border-radius: Spacing.radius-md;
                                background: Palette.accent;
                                VerticalLayout {
                                    padding: Spacing.space-sm;
                                    alignment: space-between;
                                    Text { text: "accent"; font-size: Typography.size-sm; color: #ffffff; font-weight: Typography.weight-bold; }
                                    Text { text: "#3B82F6"; font-size: Typography.size-xs; color: #ffffffcc; }
                                }
                            }

                            Rectangle {
                                height: 90px;
                                border-radius: Spacing.radius-md;
                                background: Palette.danger;
                                VerticalLayout {
                                    padding: Spacing.space-sm;
                                    alignment: space-between;
                                    Text { text: "danger"; font-size: Typography.size-sm; color: #ffffff; font-weight: Typography.weight-bold; }
                                    Text { text: "#EF4444"; font-size: Typography.size-xs; color: #ffffffcc; }
                                }
                            }

                            Rectangle {
                                height: 90px;
                                border-radius: Spacing.radius-md;
                                background: Palette.success;
                                VerticalLayout {
                                    padding: Spacing.space-sm;
                                    alignment: space-between;
                                    Text { text: "success"; font-size: Typography.size-sm; color: #ffffff; font-weight: Typography.weight-bold; }
                                    Text { text: "#10B981"; font-size: Typography.size-xs; color: #ffffffcc; }
                                }
                            }
                        }

                        // Typography Scale Demo
                        VerticalLayout {
                            spacing: Spacing.space-sm;

                            Text {
                                text: "Typography Scales (HiDPI Native Calibrated)";
                                font-family: Typography.font-family;
                                font-size: Typography.size-lg;
                                font-weight: Typography.weight-semibold;
                                color: Palette.text-primary;
                            }

                            Rectangle {
                                border-radius: Spacing.radius-md;
                                border-width: 1px;
                                border-color: Palette.border-subtle;
                                background: Palette.bg-surface;

                                VerticalLayout {
                                    padding: Spacing.space-md;
                                    spacing: Spacing.space-sm;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Headline 2XL (28px)"; font-family: Typography.font-family; font-size: Typography.size-2xl; font-weight: Typography.weight-bold; color: Palette.text-primary; }
                                        Text { text: "Typography.size-2xl • 700"; font-size: Typography.size-sm; color: Palette.text-secondary; vertical-alignment: center; }
                                    }
                                    Rectangle { height: 1px; background: Palette.border-subtle; }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Title XL (23px)"; font-family: Typography.font-family; font-size: Typography.size-xl; font-weight: Typography.weight-semibold; color: Palette.text-primary; }
                                        Text { text: "Typography.size-xl • 600"; font-size: Typography.size-sm; color: Palette.text-secondary; vertical-alignment: center; }
                                    }
                                    Rectangle { height: 1px; background: Palette.border-subtle; }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Section LG (19px)"; font-family: Typography.font-family; font-size: Typography.size-lg; font-weight: Typography.weight-medium; color: Palette.text-primary; }
                                        Text { text: "Typography.size-lg • 500"; font-size: Typography.size-sm; color: Palette.text-secondary; vertical-alignment: center; }
                                    }
                                    Rectangle { height: 1px; background: Palette.border-subtle; }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Body Base (16px)"; font-family: Typography.font-family; font-size: Typography.size-base; color: Palette.text-primary; }
                                        Text { text: "Typography.size-base • 400"; font-size: Typography.size-sm; color: Palette.text-secondary; vertical-alignment: center; }
                                    }
                                    Rectangle { height: 1px; background: Palette.border-subtle; }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Caption SM (15px)"; font-family: Typography.font-family; font-size: Typography.size-sm; color: Palette.text-secondary; }
                                        Text { text: "Typography.size-sm • 400"; font-size: Typography.size-sm; color: Palette.text-secondary; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // Spacing Scale Tokens
                        VerticalLayout {
                            spacing: Spacing.space-sm;

                            Text {
                                text: "Layout Grid & Spacing Scales";
                                font-family: Typography.font-family;
                                font-size: Typography.size-lg;
                                font-weight: Typography.weight-semibold;
                                color: Palette.text-primary;
                            }

                            HorizontalLayout {
                                spacing: Spacing.space-md;

                                Rectangle {
                                    height: 50px;
                                    border-radius: Spacing.radius-md;
                                    border-width: 1px;
                                    border-color: Palette.border-subtle;
                                    background: Palette.bg-surface;
                                    HorizontalLayout {
                                        padding: Spacing.space-sm;
                                        alignment: center;
                                        Text { text: "space-xs: 4px"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                    }
                                }
                                Rectangle {
                                    height: 50px;
                                    border-radius: Spacing.radius-md;
                                    border-width: 1px;
                                    border-color: Palette.border-subtle;
                                    background: Palette.bg-surface;
                                    HorizontalLayout {
                                        padding: Spacing.space-sm;
                                        alignment: center;
                                        Text { text: "space-sm: 8px"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                    }
                                }
                                Rectangle {
                                    height: 50px;
                                    border-radius: Spacing.radius-md;
                                    border-width: 1px;
                                    border-color: Palette.border-subtle;
                                    background: Palette.bg-surface;
                                    HorizontalLayout {
                                        padding: Spacing.space-sm;
                                        alignment: center;
                                        Text { text: "space-md: 16px"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                    }
                                }
                                Rectangle {
                                    height: 50px;
                                    border-radius: Spacing.radius-md;
                                    border-width: 1px;
                                    border-color: Palette.border-subtle;
                                    background: Palette.bg-surface;
                                    HorizontalLayout {
                                        padding: Spacing.space-sm;
                                        alignment: center;
                                        Text { text: "space-lg: 24px"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                    }
                                }
                                Rectangle {
                                    height: 50px;
                                    border-radius: Spacing.radius-md;
                                    border-width: 1px;
                                    border-color: Palette.border-subtle;
                                    background: Palette.bg-surface;
                                    HorizontalLayout {
                                        padding: Spacing.space-sm;
                                        alignment: center;
                                        Text { text: "space-xl: 32px"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 3: SYSTEM CONFIG (Theme Toggle Moved Here!)
                    // ==========================================
                    if root.selected-tab == 3: VerticalLayout {
                        spacing: Spacing.space-lg;

                        Text {
                            text: "Appearance & Environment";
                            font-family: Typography.font-family;
                            font-size: Typography.size-lg;
                            font-weight: Typography.weight-semibold;
                            color: Palette.text-primary;
                        }

                        // Clean, Perfectly-Aligned Dark Mode Setting Row
                        Rectangle {
                            border-radius: Spacing.radius-lg;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            background: Palette.bg-surface;

                            HorizontalLayout {
                                padding: Spacing.space-lg;
                                alignment: space-between;

                                // Left: Setting Info
                                HorizontalLayout {
                                    spacing: Spacing.space-md;
                                    alignment: center;

                                    Image {
                                        source: @image-url("../assets/icons/tokens.svg");
                                        width: 24px;
                                        height: 24px;
                                        colorize: Palette.accent;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        spacing: 2px;
                                        alignment: center;

                                        Text {
                                            text: "Dark Mode Palette";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-base;
                                            font-weight: Typography.weight-semibold;
                                            color: Palette.text-primary;
                                        }
                                        Text {
                                            text: Palette.dark-mode ? "Active: Slate Dark Theme (#0F172A)" : "Active: Clean Light Theme (#F8FAFC)";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-sm;
                                            color: Palette.text-secondary;
                                        }
                                    }
                                }

                                // Right: Toggle Switch (Perfect single-line vertical alignment)
                                HorizontalLayout {
                                    alignment: center;
                                    ToggleSwitch {
                                        checked <=> Palette.dark-mode;
                                    }
                                }
                            }
                        }

                        // Hardware Diagnostics Alert
                        Alert {
                            status: "success";
                            title: "Hardware Environment Certified";
                            message: "Operating System: 64-bit Desktop. Graphics Surface: Direct3D/Metal/Vulkan with subpixel font smoothing.";
                        }

                        // Distribution Export Card
                        Rectangle {
                            border-radius: Spacing.radius-lg;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            background: Palette.bg-surface;

                            HorizontalLayout {
                                padding: Spacing.space-lg;
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: center;

                                    Text {
                                        text: "Package Standalone Distribution";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-base;
                                        font-weight: Typography.weight-semibold;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "Compiles complete library into a single optimized 7.7 MB executable.";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-sm;
                                        color: Palette.text-secondary;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Export Binary (.exe)";
                                        variant: "primary";
                                        clicked => {
                                            root.show-modal = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal Dialog Overlay
    ModalDialog {
        is-open <=> root.show-modal;
        title: "Export Native Component Library";
        message: "Are you sure you want to package this desktop design system? All component tokens, atomic styles, and molecules will be compiled into your standalone distribution.";
        confirm-text: "Export Standalone";
        confirm-variant: "primary";
        confirmed => {
            root.trigger-sample-toast("success", "Export Completed", "Distribution binary verified and packaged in target/release/.");
        }
    }

    // Floating Toast Notification (Anchored to bottom-right corner)
    toast := ToastNotification {
        x: root.width - self.width - 24px;
        y: root.height - self.height - 24px;
        is-open <=> root.toast-open;
        title: root.toast-title;
        message: root.toast-message;
        status: root.toast-status;
    }
}
