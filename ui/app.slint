import { ScrollView } from "std-widgets.slint";
import { Palette } from "tokens/colors.slint";
import { Typography } from "tokens/typography.slint";
import { Spacing } from "tokens/spacing.slint";
import { Button } from "atoms/button.slint";
import { TextInputField } from "atoms/input.slint";
import { ToggleSwitch } from "atoms/toggle.slint";
import { Checkbox } from "atoms/checkbox.slint";
import { Badge } from "atoms/badge.slint";
import { ProgressBar } from "atoms/progressbar.slint";
import { Slider } from "atoms/slider.slint";
import { RadioButton } from "atoms/radio.slint";
import { Spinner } from "atoms/spinner.slint";
import { Stepper } from "atoms/stepper.slint";
import { Divider } from "atoms/divider.slint";
import { AccordionItem } from "molecules/accordion.slint";
import { Alert } from "molecules/alert.slint";
import { SegmentedTabs } from "molecules/tabs.slint";
import { Tooltip } from "molecules/tooltip.slint";
import { Breadcrumbs } from "molecules/breadcrumbs.slint";
import { DatePicker } from "molecules/datepicker.slint";
import { TimePicker } from "molecules/timepicker.slint";
import { TreeView, TreeNodeData } from "molecules/treeview.slint";
import { FormField } from "molecules/form_field.slint";
import { ContextMenu, ContextMenuItem } from "molecules/context_menu.slint";
import { ReceiptCanvas, ReceiptItem } from "molecules/receipt_preview.slint";
import { ModalDialog } from "organisms/modal.slint";
import { Dropdown } from "organisms/dropdown.slint";
import { LiveFeedView, FeedItem } from "organisms/feed.slint";
import { DesktopSidebar } from "organisms/sidebar.slint";
import { ToastNotification } from "organisms/toast.slint";
import { DataTable, TableRowData } from "organisms/table.slint";
import { CrudModal } from "organisms/crud_modal.slint";
import { BatchEditModal } from "organisms/batch_edit_modal.slint";
import { Avatar } from "atoms/avatar.slint";
import { Skeleton } from "atoms/skeleton.slint";
import { Chip } from "molecules/chip.slint";
import { Pagination } from "molecules/pagination.slint";
import { ColorPicker, ColorSwatchItem } from "molecules/color_picker.slint";
import { StatusBar } from "organisms/statusbar.slint";
import { CommandPalette, CommandItem } from "organisms/command_palette.slint";
import { CreditBadge } from "molecules/credit_badge.slint";
import { PricingCard } from "molecules/pricing_card.slint";
import { PlanSelector } from "organisms/plan_selector.slint";
import { CheckoutModal } from "organisms/checkout_modal.slint";

export { Palette, FeedItem, TableRowData, TreeNodeData, CommandItem, ColorSwatchItem }

export component AppWindow inherits Window {
    title: "Native Desktop Design System";
    icon: @image-url("../assets/app-icon.png");
    min-width: 960px;
    min-height: 680px;
    preferred-width: 1080px;
    preferred-height: 760px;
    background: Palette.bg-canvas;
    forward-focus: root-focus;

    in-out property <bool> show-modal: false;
    in-out property <int> selected-tab: 0;
    in-out property <int> selected-tier-tab: 0;
    in-out property <bool> sidebar-collapsed: false;
    callback sidebar-toggle-collapsed(bool);
    in-out property <string> theme-mode-status: "Auto-synced with SQLite database";
    callback theme-toggle-dark-mode(bool);
    callback theme-set-mode(string);
    callback theme-reset-os();

    // Checkout & Monetization State
    in-out property <bool> checkout-modal-open: false;
    in-out property <string> checkout-plan-title: "Pro Developer License";
    in-out property <string> checkout-plan-price: "$180";
    in-out property <string> checkout-billing-cycle: "yearly";
    in-out property <string> checkout-active-plan: "free";
    in-out property <int> checkout-payment-tab: 0;
    in-out property <int> checkout-crypto-step: 0;
    in-out property <int> checkout-crypto-blocks: 0;
    in-out property <string> checkout-feedback: "";
    in-out property <string> checkout-timer-text: "14:59";
    callback checkout-open(string, string, string);

    checkout-open(title, cycle, price) => {
        root.checkout-plan-title = title;
        root.checkout-billing-cycle = cycle;
        root.checkout-plan-price = price;
        root.checkout-crypto-step = 0;
        root.checkout-crypto-blocks = 0;
        root.checkout-feedback = "";
        root.checkout-modal-open = true;
    }

    // Tier 1 Interactive Demo Properties
    in-out property <float> demo-slider-val: 72.0;
    in-out property <bool> demo-chk-1: true;
    in-out property <bool> demo-chk-2: false;
    in-out property <bool> demo-chk-3: false;
    in-out property <bool> demo-indeterminate: true;

    // Tier 2 Interactive Demo Properties
    in-out property <int> demo-radio-sel: 0;
    in-out property <int> demo-stepper-val: 16;
    in-out property <bool> demo-tooltip-hover: false;
    in-out property <string> demo-date: "2026-10-29";
    in-out property <string> demo-time-24: "14:30";

    // FormField & ContextMenu demo properties
    in-out property <string> demo-field-email: "merchant@native-commerce.io";
    in-out property <string> demo-field-sku: "BEV-001";
    in-out property <string> demo-field-price: "34.50";
    in-out property <[ContextMenuItem]> demo-context-items: [
        { id: "edit", label: "Edit Product Record", shortcut: "Ctrl+E", icon: "settings", is-danger: false, is-divider: false, enabled: true },
        { id: "discount", label: "Apply 10% Line Discount", shortcut: "Ctrl+D", icon: "check", is-danger: false, is-divider: false, enabled: true },
        { id: "divider", label: "", shortcut: "", icon: "", is-danger: false, is-divider: true, enabled: true },
        { id: "delete", label: "Delete Line Item", shortcut: "Del", icon: "close", is-danger: true, is-divider: false, enabled: true }
    ];

    // New Tier 1, 2, 3 Interactive Demo Properties
    in-out property <bool> demo-skeleton-animated: true;
    in-out property <int> demo-page: 1;
    in-out property <color> demo-color: #3b82f6;
    in-out property <string> demo-color-hex: "#3b82f6";
    in-out property <bool> demo-chip-1: true;
    in-out property <bool> demo-chip-2: true;
    in-out property <bool> demo-chip-3: true;
    in-out property <bool> demo-chip-4: true;
    in-out property <bool> demo-chip-5: true;
    in-out property <bool> show-command-palette: false;
    in-out property <[CommandItem]> palette-commands: [
        { id: "toggle-theme", title: "Cycle Theme (Slate / Light / Sepia)", category: "Preferences", shortcut: "Ctrl+T", icon: "theme" },
        { id: "set-theme-sepia", title: "Switch to Vintage Sepia Theme", category: "Preferences", shortcut: "", icon: "theme" },
        { id: "set-theme-dark", title: "Switch to Slate Dark Theme", category: "Preferences", shortcut: "", icon: "theme" },
        { id: "set-theme-light", title: "Switch to Clean Light Theme", category: "Preferences", shortcut: "", icon: "theme" },
        { id: "table-select-all", title: "Batch Select All Services", category: "Table", shortcut: "", icon: "system" },
        { id: "table-deselect-all", title: "Deselect All Services", category: "Table", shortcut: "", icon: "system" },
        { id: "open-pos", title: "Launch POS Retail Terminal", category: "Examples", shortcut: "F8", icon: "pos" },
        { id: "open-devforge", title: "Launch DevForge Developer Studio", category: "Examples", shortcut: "F9", icon: "devforge" },
        { id: "open-treeview", title: "Scan Local Workspace Filesystem", category: "Explorer", shortcut: "Ctrl+E", icon: "explorer" },
        { id: "refresh-telemetry", title: "Refresh 360° Hardware Telemetry", category: "System", shortcut: "F5", icon: "telemetry" },
        { id: "create-shortcut", title: "Create Native Desktop Shortcut", category: "System", shortcut: "", icon: "shortcut" },
    ];
    callback command-palette-action(string);
    callback command-palette-search(string);
    callback accent-color-changed(string);

    // TreeView & File Explorer Properties
    in-out property <[TreeNodeData]> tree-items: [
        { id: "root", label: "desktop-design-system", icon: "folder", level: 0, is-folder: true, expanded: true, has-children: true, badge: "root" },
        { id: "src", label: "src", icon: "folder", level: 1, is-folder: true, expanded: true, has-children: true, badge: "dir" },
        { id: "src-main", label: "main.rs", icon: "code", level: 2, is-folder: false, expanded: false, has-children: false, badge: "18.4 KB" },
        { id: "src-lib", label: "lib.rs", icon: "code", level: 2, is-folder: false, expanded: false, has-children: false, badge: "0.4 KB" },
        { id: "src-sys", label: "system_info.rs", icon: "code", level: 2, is-folder: false, expanded: false, has-children: false, badge: "9.2 KB" },
        { id: "src-tree", label: "file_tree.rs", icon: "code", level: 2, is-folder: false, expanded: false, has-children: false, badge: "6.8 KB" },
        { id: "src-db", label: "db", icon: "folder", level: 2, is-folder: true, expanded: false, has-children: true, badge: "dir" },
        { id: "ui", label: "ui", icon: "folder", level: 1, is-folder: true, expanded: true, has-children: true, badge: "dir" },
        { id: "ui-app", label: "app.slint", icon: "code", level: 2, is-folder: false, expanded: false, has-children: false, badge: "42.1 KB" },
        { id: "ui-index", label: "index.slint", icon: "code", level: 2, is-folder: false, expanded: false, has-children: false, badge: "2.1 KB" },
        { id: "cargo", label: "Cargo.toml", icon: "code", level: 1, is-folder: false, expanded: false, has-children: false, badge: "1.1 KB" },
        { id: "readme", label: "README.md", icon: "file", level: 1, is-folder: false, expanded: false, has-children: false, badge: "8.5 KB" }
    ];
    in-out property <string> tree-selected-id: "src-main";
    in-out property <string> tree-selected-label: "main.rs";
    in-out property <bool> tree-selected-is-folder: false;
    in-out property <string> tree-selected-badge: "18.4 KB";
    callback tree-node-selected(string, string, bool);
    callback tree-toggle-expand(string, bool);
    callback tree-refresh-scan();
    in-out property <string> tree-current-path: ".";
    callback tree-browse-folder();
    callback tree-load-path(string);
    callback tree-quick-jump(string);

    // Desktop Shortcut Generator properties & callbacks
    in-out property <bool> shortcut-installed: false;
    in-out property <string> shortcut-path: "";
    callback create-desktop-shortcut();
    callback remove-desktop-shortcut();
    callback check-desktop-shortcut();

    // Live Feed properties & callbacks
    in-out property <[FeedItem]> live-feed-items: [];
    in-out property <bool> is-feed-paused: true;
    callback toggle-feed-pause();
    callback clear-feed();

    // Local SQLite CRUD properties & callbacks
    in-out property <[TableRowData]> db-records: [];
    in-out property <int> selected-record-idx: 0;
    in-out property <int> db-selected-count: 0;
    in-out property <bool> show-crud-modal: false;
    in-out property <bool> show-delete-confirm: false;
    in-out property <bool> show-batch-edit-modal: false;
    in-out property <bool> show-batch-delete-confirm: false;
    in-out property <bool> is-editing-record: false;
    in-out property <string> edit-record-id: "";
    in-out property <string> form-service: "";
    in-out property <string> form-runtime: "";
    in-out property <string> form-status: "Active";
    in-out property <string> form-latency: "1.0 ms";
    callback db-add-record(string, string, string, string);
    callback db-update-record(string, string, string, string, string);
    callback db-delete-selected(int);
    callback db-refresh();
    callback db-toggle-row-selected(int);
    callback db-select-all(bool);
    callback db-batch-delete();
    callback db-batch-set-status(string);
    callback db-batch-update(bool, string, bool, string, bool, string);

    // Toast Notification properties & callbacks
    in-out property <bool> toast-open: false;
    in-out property <string> toast-title: "Settings Saved";
    in-out property <string> toast-message: "Native preferences updated successfully.";
    in-out property <string> toast-status: "success";
    callback trigger-sample-toast(string, string, string); // (status, title, message)

    // Live Hardware Diagnostics (360° System Telemetry)
    in-out property <string> hw-os-name: "Detecting OS...";
    in-out property <string> hw-host-name: "Host";
    in-out property <string> hw-uptime: "0h 0m";
    in-out property <string> hw-app-memory: "15.6 MB";
    in-out property <string> hw-cpu-brand: "Detecting CPU...";
    in-out property <int> hw-cpu-cores: 8;
    in-out property <float> hw-cpu-usage: 0.0;
    in-out property <string> hw-cpu-freq: "3.2 GHz";
    in-out property <string> hw-ram-total: "16.0 GB";
    in-out property <string> hw-ram-used: "6.4 GB";
    in-out property <string> hw-ram-free: "9.6 GB";
    in-out property <float> hw-ram-usage: 0.0;
    in-out property <string> hw-gpu-name: "Detecting GPU...";
    in-out property <string> hw-gpu-secondary: "Integrated GPU";
    in-out property <string> hw-graphics-backend: "Direct3D 12";
    callback refresh-hardware-diagnostics();

    // Master Desktop Layout: Keyboard Focus Scope + Sidebar on Left + Content on Right
    root-focus := FocusScope {
        key-pressed(event) => {
            if event.modifiers.control && (event.text == "k" || event.text == "K") {
                root.show-command-palette = !root.show-command-palette;
                return accept;
            }
            if event.modifiers.control && (event.text == "t" || event.text == "T") {
                root.command-palette-action("toggle-theme");
                return accept;
            }
            if event.text == Key.Escape {
                if root.show-command-palette {
                    root.show-command-palette = false;
                    return accept;
                }
                if root.show-modal {
                    root.show-modal = false;
                    return accept;
                }
                if root.show-crud-modal {
                    root.show-crud-modal = false;
                    return accept;
                }
                if root.show-delete-confirm {
                    root.show-delete-confirm = false;
                    return accept;
                }
                if root.show-batch-edit-modal {
                    root.show-batch-edit-modal = false;
                    return accept;
                }
                if root.show-batch-delete-confirm {
                    root.show-batch-delete-confirm = false;
                    return accept;
                }
            }
            return reject;
        }

        VerticalLayout {
            HorizontalLayout {
                vertical-stretch: 1;

                // 1. Collapsible Desktop Sidebar
            sidebar := DesktopSidebar {
            active-index <=> root.selected-tab;
            collapsed <=> root.sidebar-collapsed;
            toggle-collapse => {
                root.sidebar-toggle-collapsed(root.sidebar-collapsed);
            }
        }

        // 2. Main Application Workspace
        VerticalLayout {
            horizontal-stretch: 1;

            // Top Header Bar (Clean, decluttered)
            Rectangle {
                height: 64px;
                background: Palette.bg-surface;
                border-width: 1px;
                border-color: Palette.border-subtle;

                HorizontalLayout {
                    padding-left: Spacing.space-xl;
                    padding-right: Spacing.space-xl;
                    alignment: space-between;

                    // Active Section Title & Breadcrumb
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;

                        Text {
                            text: root.selected-tab == 0 ? "Component Library" :
                                  root.selected-tab == 1 ? "Live Telemetry" :
                                  root.selected-tab == 2 ? "Design Tokens" :
                                  "System Configuration";
                            font-family: Typography.font-family;
                            font-size: Typography.size-xl;
                            font-weight: Typography.weight-bold;
                            color: Palette.text-primary;
                        }
                        Text {
                            text: "Pure Native Rust • 120 FPS GPU Engine • Multi-platform";
                            font-family: Typography.font-family;
                            font-size: Typography.size-xs;
                            color: Palette.text-secondary;
                        }
                    }

                    // Quick Command Palette Spotlight Trigger (Vertically Centered in 64px Header)
                    VerticalLayout {
                        alignment: center;

                        Rectangle {
                            height: 36px;
                            border-radius: Spacing.radius-md;
                            background: cmd-quick-touch.has-hover ? Palette.bg-surface-hover : Palette.bg-subtle;
                            border-width: 1px;
                            border-color: Palette.border-subtle;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                alignment: center;

                                // Vertically Centered Search Icon
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/icons/search.svg");
                                        width: 14px;
                                        height: 14px;
                                        colorize: Palette.text-secondary;
                                    }
                                }

                                Text {
                                    text: "Command Palette";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    font-weight: Typography.weight-medium;
                                    color: Palette.text-secondary;
                                    vertical-alignment: center;
                                }

                                // Vertically Centered Shortcut Badge
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: Palette.bg-subtle-hover;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            alignment: center;

                                            Text {
                                                text: "Ctrl+K";
                                                font-family: "Consolas, monospace";
                                                font-size: 10px;
                                                font-weight: Typography.weight-semibold;
                                                color: Palette.text-primary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            cmd-quick-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.show-command-palette = true;
                                }
                            }
                        }
                    }
                }
            }

            // Scrollable Active View Surface
            ScrollView {
                VerticalLayout {
                    padding: Spacing.space-xl;
                    spacing: Spacing.space-lg;

                    // Segmented Tabs Bar
                    SegmentedTabs {
                        tabs: ["Components", "Live Feed", "Design Tokens", "System"];
                        active-tab <=> root.selected-tab;
                    }

                    Rectangle {
                        height: 1px;
                        background: Palette.border-subtle;
                    }

                    // ==========================================
                    // TAB 0: COMPONENTS SHOWCASE (Segmented by Tiers)
                    // ==========================================
                    if root.selected-tab == 0: VerticalLayout {
                        spacing: Spacing.space-lg;

                        // Tier Selection Sub-Tabs
                        SegmentedTabs {
                            tabs: [
                                "Tier 1: Atomic Primitives",
                                "Tier 2: Interactive Molecules",
                                "Tier 3: Desktop Organisms & Tools"
                            ];
                            active-tab <=> root.selected-tier-tab;
                        }

                        Rectangle {
                            height: 1px;
                            background: Palette.border-subtle;
                        }

                        // ----------------------------------------------------
                        // SUB-TAB 0: TIER 1 ATOMIC PRIMITIVES
                        // ----------------------------------------------------
                        if root.selected-tier-tab == 0: VerticalLayout {
                            spacing: 28px;

                            // 1. Buttons & Actions
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "Buttons & Action Controls (Tier 1 Atoms)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Interactive action buttons with hover states, focus rings, and variant colorways.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-md;
                                    Button { text: "Primary Action"; variant: "primary"; }
                                    Button { text: "Secondary"; variant: "secondary"; }
                                    Button { text: "Ghost Action"; variant: "ghost"; }
                                    Button { text: "Destructive Action"; variant: "danger"; }
                                    Button { text: "Disabled Action"; enabled: false; }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 2. Inputs & Form Fields
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "Inputs & Form Fields (Tier 1 Atoms)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Single-line inputs with focus accents, placeholder hints, and password masking.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-lg;
                                    TextInputField {
                                        placeholder: "Search components or documentation...";
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                    }
                                    TextInputField {
                                        placeholder: "Enter secret credentials...";
                                        input-type: InputType.password;
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 3. Status Badges & Indicators
                            VerticalLayout {
                                spacing: Spacing.space-md;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Status Badges & Pills (Tier 1 Atoms)";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-lg;
                                        font-weight: Typography.weight-semibold;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "Compact high-contrast pills with live colored status dots and theme-aware tints.";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-xs;
                                        color: Palette.text-secondary;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-md;
                                    alignment: start;

                                    Badge {
                                        text: "Engine Active";
                                        variant: "success";
                                        has-dot: true;
                                    }

                                    Badge {
                                        text: "Rust v1.9 Native";
                                        variant: "primary";
                                        has-dot: true;
                                    }

                                    Badge {
                                        text: "LTO Strip Active";
                                        variant: "warning";
                                        has-dot: true;
                                    }

                                    Badge {
                                        text: "Buffer Spike";
                                        variant: "danger";
                                        has-dot: true;
                                    }

                                    Badge {
                                        text: "Zero Web Overhead";
                                        variant: "neutral";
                                        has-dot: false;
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 4. Checkboxes & Selection Controls
                            VerticalLayout {
                                spacing: Spacing.space-md;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Checkboxes & Selection (Tier 1 Atoms)";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-lg;
                                        font-weight: Typography.weight-semibold;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "Accessible desktop checkbox states: checked, unchecked, indeterminate, and disabled.";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-xs;
                                        color: Palette.text-secondary;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-xl;
                                    alignment: start;

                                    VerticalLayout {
                                        spacing: Spacing.space-sm;
                                        Checkbox {
                                            text: "Hardware Direct3D/Metal acceleration";
                                            checked <=> root.demo-chk-1;
                                        }
                                        Checkbox {
                                            text: "Subpixel antialiasing & LCD font smoothing";
                                            checked <=> root.demo-chk-2;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: Spacing.space-sm;
                                        Checkbox {
                                            text: "Batch compile multi-target distribution";
                                            indeterminate <=> root.demo-indeterminate;
                                        }
                                        Checkbox {
                                            text: "Software legacy rasterizer (Deprecated)";
                                            enabled: false;
                                            checked: false;
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 5. Sliders & Progress Indicators
                            VerticalLayout {
                                spacing: Spacing.space-md;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Sliders & Progress Controls (Tier 1 Atoms)";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-lg;
                                        font-weight: Typography.weight-semibold;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "Drag the slider thumb to dynamically update the progress bar in real-time.";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-xs;
                                        color: Palette.text-secondary;
                                    }
                                }

                                VerticalLayout {
                                    spacing: Spacing.space-sm;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "GPU Memory Buffer Allocation";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-sm;
                                            font-weight: Typography.weight-medium;
                                            color: Palette.text-primary;
                                        }
                                        Text {
                                            text: Math.round(root.demo-slider-val) + "% Allocated";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-sm;
                                            color: Palette.accent;
                                            font-weight: Typography.weight-semibold;
                                        }
                                    }

                                    Slider {
                                        value <=> root.demo-slider-val;
                                        minimum: 0.0;
                                        maximum: 100.0;
                                        show-value: false;
                                    }

                                    ProgressBar {
                                        progress: root.demo-slider-val / 100.0;
                                        bar-height: 8px;
                                        variant: root.demo-slider-val > 85.0 ? "danger" : "primary";
                                    }
                                }

                                VerticalLayout {
                                    spacing: Spacing.space-xs;
                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Shader Compilation Pipeline";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-xs;
                                            color: Palette.text-secondary;
                                        }
                                        Text {
                                            text: "100% Completed";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-xs;
                                            color: Palette.success;
                                            font-weight: Typography.weight-semibold;
                                        }
                                    }

                                    ProgressBar {
                                        progress: 1.0;
                                        bar-height: 6px;
                                        variant: "success";
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 6. Radio Groups & Mutually Exclusive Choices
                            VerticalLayout {
                                spacing: Spacing.space-md;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Radio Selection & Options (Tier 1 Atoms)";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-lg;
                                        font-weight: Typography.weight-semibold;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "Accessible mutually exclusive selection with primary and secondary description text.";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-xs;
                                        color: Palette.text-secondary;
                                    }
                                }

                                VerticalLayout {
                                    spacing: Spacing.space-sm;

                                    RadioButton {
                                        text: "DirectX 12 / Metal Hardware Pipeline";
                                        description: "Maximum GPU throughput at 120 FPS native refresh rate.";
                                        checked: root.demo-radio-sel == 0;
                                        toggled => { root.demo-radio-sel = 0; }
                                    }

                                    RadioButton {
                                        text: "Vulkan Cross-Platform Graphics";
                                        description: "Unified shading engine optimized for multi-vendor desktop GPUs.";
                                        checked: root.demo-radio-sel == 1;
                                        toggled => { root.demo-radio-sel = 1; }
                                    }

                                    RadioButton {
                                        text: "Low-Power Headless Software Rasterizer";
                                        description: "Fallback CPU execution for background automation environments.";
                                        checked: root.demo-radio-sel == 2;
                                        toggled => { root.demo-radio-sel = 2; }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 7. Numeric Steppers & Spinners
                            VerticalLayout {
                                spacing: Spacing.space-md;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Numeric Steppers & Spinners (Tier 1 Atoms)";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-lg;
                                        font-weight: Typography.weight-semibold;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "Precision value inputs and async vector activity spinners.";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-xs;
                                        color: Palette.text-secondary;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-xl;
                                    alignment: start;

                                    VerticalLayout {
                                        spacing: Spacing.space-xs;
                                        Text {
                                            text: "Typography Base Scale";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-sm;
                                            color: Palette.text-primary;
                                            font-weight: Typography.weight-medium;
                                        }
                                        Stepper {
                                            value <=> root.demo-stepper-val;
                                            minimum: 8;
                                            maximum: 48;
                                            step: 2;
                                            unit: "px";
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: Spacing.space-xs;
                                        Text {
                                            text: "Background Compiler Status";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-sm;
                                            color: Palette.text-primary;
                                            font-weight: Typography.weight-medium;
                                        }
                                        HorizontalLayout {
                                            spacing: Spacing.space-sm;
                                            alignment: start;
                                            Spinner {
                                                size: 22px;
                                                spinner-color: Palette.accent;
                                            }
                                            Text {
                                                text: "JIT Shaders compiling in background...";
                                                font-family: Typography.font-family;
                                                font-size: Typography.size-xs;
                                                color: Palette.text-secondary;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 8. User Profile Avatars & Presence States (Tier 1 Atoms)
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "User Profile Avatars & Presence Indicators (Tier 1 Atoms)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Compact profile representations with initials, custom sizing, and real-time presence indicators (online, busy, away, offline).";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-lg;
                                    alignment: start;

                                    HorizontalLayout {
                                        spacing: Spacing.space-md;
                                        alignment: center;

                                        Avatar {
                                            initials: "JD";
                                            size: 28px;
                                            status: "online";
                                            clicked => {
                                                root.trigger-sample-toast("success", "Avatar Selected", "John Doe (Online) - 28px");
                                            }
                                        }

                                        Avatar {
                                            initials: "AK";
                                            size: 36px;
                                            status: "busy";
                                            background-color: Palette.dark-mode ? #1e3a8a : #dbeafe;
                                            text-color: #3b82f6;
                                            clicked => {
                                                root.trigger-sample-toast("danger", "Avatar Selected", "Alice Kim (Busy) - 36px");
                                            }
                                        }

                                        Avatar {
                                            initials: "TS";
                                            size: 44px;
                                            status: "away";
                                            background-color: Palette.dark-mode ? #78350f : #fef3c7;
                                            text-color: #d97706;
                                            clicked => {
                                                root.trigger-sample-toast("warning", "Avatar Selected", "Thomas Scott (Away) - 44px");
                                            }
                                        }

                                        Avatar {
                                            initials: "RL";
                                            size: 54px;
                                            status: "offline";
                                            background-color: Palette.dark-mode ? #064e3b : #d1fae5;
                                            text-color: #059669;
                                            clicked => {
                                                root.trigger-sample-toast("info", "Avatar Selected", "Rachel Lee (Offline) - 54px");
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 9. Skeleton & Shimmer Placeholders (Tier 1 Atoms)
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "Skeleton & Shimmer Content Loaders (Tier 1 Atoms)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Lightweight placeholders that mimic layout shapes during async data fetching with zero UI freezing.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-xl;

                                    // Circular & Line Skeleton Card
                                    Rectangle {
                                        border-radius: Spacing.radius-md;
                                        background: Palette.bg-surface;
                                        border-width: 1px;
                                        border-color: Palette.border-subtle;

                                        HorizontalLayout {
                                            padding: Spacing.space-md;
                                            spacing: Spacing.space-md;
                                            alignment: center;

                                            Skeleton {
                                                variant: "circular";
                                                skeleton-height: 48px;
                                            }

                                            VerticalLayout {
                                                spacing: 8px;
                                                Skeleton {
                                                    variant: "text";
                                                    skeleton-height: 16px;
                                                }
                                                Skeleton {
                                                    variant: "text";
                                                    skeleton-height: 12px;
                                                }
                                            }
                                        }
                                    }

                                    // Rectangular Skeleton Card
                                    Rectangle {
                                        border-radius: Spacing.radius-md;
                                        background: Palette.bg-surface;
                                        border-width: 1px;
                                        border-color: Palette.border-subtle;

                                        VerticalLayout {
                                            padding: Spacing.space-md;
                                            spacing: 8px;

                                            Skeleton {
                                                variant: "rectangular";
                                                skeleton-height: 42px;
                                            }
                                            Skeleton {
                                                variant: "text";
                                                skeleton-height: 12px;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // ----------------------------------------------------
                        // SUB-TAB 1: TIER 2 INTERACTIVE MOLECULES
                        // ----------------------------------------------------
                        if root.selected-tier-tab == 1: VerticalLayout {
                            spacing: 28px;

                            // 1. Date & Time Selection (Molecules)
                            VerticalLayout {
                                spacing: Spacing.space-md;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Date & Time Pickers (Tier 2 Molecules)";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-lg;
                                        font-weight: Typography.weight-semibold;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "Interactive calendar popover with month navigation and precision time steppers.";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-xs;
                                        color: Palette.text-secondary;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-xl;
                                    alignment: start;

                                    DatePicker {
                                        width: 270px;
                                        label: "Target Deployment Date";
                                        formatted-date <=> root.demo-date;
                                        date-selected(d) => {
                                            root.trigger-sample-toast("info", "Date Selected", "Scheduled for: " + d);
                                        }
                                    }

                                    TimePicker {
                                        width: 240px;
                                        label: "Execution Window (24H)";
                                        formatted-time <=> root.demo-time-24;
                                        is-24h: true;
                                        time-selected(t) => {
                                            root.trigger-sample-toast("info", "Time Selected", "Execution window: " + t);
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 2. Accordions
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "Accordion Disclosure Panels (Tier 2 Molecules)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Expandable content panels with smooth transitions and theme support.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                VerticalLayout {
                                    spacing: Spacing.space-sm;

                                    AccordionItem {
                                        title: "Why is hardware-accelerated desktop rendering faster?";
                                        description: "Unlike Electron which boots an entire Chromium browser engine and NodeJS runtime (eating 400MB+ RAM), this design system compiles directly to native instructions and paints onto DirectX/Metal/Vulkan surfaces.";
                                        expanded: true;
                                    }

                                    AccordionItem {
                                        title: "How does the auto theme detection work?";
                                        description: "The Rust backend queries the native operating system's theme registry. When your OS switches to dark or light mode, Slint's reactive palette instantly cascades the change to all atomic and molecule components.";
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 3. Alerts & Notification Banners
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "Alerts & Notifications (Tier 2 Molecules)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Visual contextual banners for status messages and critical warnings.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                Alert {
                                    status: "info";
                                    title: "Native Direct GPU Pipeline";
                                    message: "All native components are dynamically rendered via GPU with zero web overhead.";
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 4. Contextual Tooltips & Hover Hints
                            VerticalLayout {
                                spacing: Spacing.space-xs;
                                Text {
                                    text: "Contextual Hint Popovers (Tier 2 Molecules)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Floating hints that appear when hovering over triggers.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-md;
                                    alignment: start;

                                    tip-card := Rectangle {
                                        width: 140px;
                                        height: 38px;
                                        border-radius: Spacing.radius-md;
                                        border-width: 1.5px;
                                        border-color: tip-touch.has-hover ? Palette.accent : Palette.border-strong;
                                        background: tip-touch.has-hover ? Palette.bg-surface-hover : Palette.bg-surface;

                                        Text {
                                            text: "Hover For Hint";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-sm;
                                            font-weight: Typography.weight-medium;
                                            color: Palette.text-primary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        tip-touch := TouchArea {
                                            mouse-cursor: pointer;
                                        }
                                    }

                                    Tooltip {
                                        text: "Direct GPU vector pipeline verified!";
                                        is-visible: tip-touch.has-hover;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 5. Hierarchical Breadcrumbs Navigation
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "Breadcrumb Hierarchy Navigation (Tier 2 Molecules)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Multi-level breadcrumb path trail with clickable segment links.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                Breadcrumbs {
                                    items: [
                                        { id: "root", label: "Clusters" },
                                        { id: "us-east", label: "US-East Direct3D" },
                                        { id: "telemetry", label: "Runtime Telemetry Matrix" }
                                    ];
                                    item-clicked(idx, id) => {
                                        root.trigger-sample-toast("info", "Breadcrumb Trail", "Navigated to: " + id);
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 6. Form Field Wrappers & Validation Feedback
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "Form Field Wrappers & Validation (Tier 2 Molecules)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Enterprise input wrappers with reactive validation states, required asterisks, and helper labels.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-lg;

                                    FormField {
                                        label: "Verified Merchant Email";
                                        required: true;
                                        text <=> root.demo-field-email;
                                        is-valid: true;
                                        helper-text: "Direct GPU account verified.";
                                    }

                                    FormField {
                                        label: "Inventory SKU / Barcode";
                                        required: true;
                                        text <=> root.demo-field-sku;
                                        has-error: true;
                                        error-text: "SKU format must match 'XXX-000'.";
                                    }

                                    FormField {
                                        label: "Unit Price (USD)";
                                        prefix-text: "$";
                                        text <=> root.demo-field-price;
                                        optional-text: "(Optional)";
                                        helper-text: "Tax calculated automatically.";
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 7. Context Menu Action Popover
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "Context Menu & Action Popovers (Tier 2 Molecules)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Floating popup menu with keyboard accelerators, destructive actions, and auto-dismissal.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-md;
                                    alignment: start;

                                    btn-wrapper := Rectangle {
                                        width: 180px;
                                        height: 40px;

                                        Button {
                                            width: 100%;
                                            height: 100%;
                                            text: "Open Context Menu";
                                            variant: "secondary";
                                            clicked => {
                                                demo-ctx-menu.show();
                                            }
                                        }

                                        demo-ctx-menu := ContextMenu {
                                            menu-y: 44px;
                                            items: root.demo-context-items;
                                            item-selected(action-id) => {
                                                root.trigger-sample-toast("info", "Context Action Triggered", "Executed menu action: " + action-id);
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 5. Interactive Chips & Filter Pills (Tier 2 Molecules)
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "Interactive Chips & Filter Pills (Tier 2 Molecules)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Compact selection and filter tags with variant styles, icons, active states, and removable dismissal.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-md;
                                    alignment: start;

                                    if root.demo-chip-1: Chip {
                                        text: "Rust 2021";
                                        has-icon: true;
                                        icon-image: @image-url("../assets/icons/code.svg");
                                        variant: "default";
                                        removable: true;
                                        clicked => {
                                            root.trigger-sample-toast("info", "Chip Clicked", "Selected tag: Rust 2021");
                                        }
                                        removed => {
                                            root.demo-chip-1 = false;
                                            root.trigger-sample-toast("warning", "Tag Removed", "Removed 'Rust 2021' chip.");
                                        }
                                    }

                                    if root.demo-chip-2: Chip {
                                        text: "Direct3D 12";
                                        has-icon: true;
                                        icon-image: @image-url("../assets/icons/zap.svg");
                                        variant: "primary";
                                        selected: true;
                                        removable: true;
                                        clicked => {
                                            root.trigger-sample-toast("info", "Chip Clicked", "Selected tag: Direct3D 12");
                                        }
                                        removed => {
                                            root.demo-chip-2 = false;
                                            root.trigger-sample-toast("warning", "Tag Removed", "Removed 'Direct3D 12' chip.");
                                        }
                                    }

                                    if root.demo-chip-3: Chip {
                                        text: "SQLite WAL Active";
                                        has-icon: true;
                                        icon-image: @image-url("../assets/icons/database.svg");
                                        variant: "success";
                                        removable: true;
                                        clicked => {
                                            root.trigger-sample-toast("info", "Chip Clicked", "Selected tag: SQLite WAL Active");
                                        }
                                        removed => {
                                            root.demo-chip-3 = false;
                                            root.trigger-sample-toast("warning", "Tag Removed", "Removed 'SQLite WAL Active' chip.");
                                        }
                                    }

                                    if root.demo-chip-4: Chip {
                                        text: "120 FPS Target";
                                        has-icon: true;
                                        icon-image: @image-url("../assets/icons/target.svg");
                                        variant: "warning";
                                        removable: true;
                                        clicked => {
                                            root.trigger-sample-toast("info", "Chip Clicked", "Selected tag: 120 FPS Target");
                                        }
                                        removed => {
                                            root.demo-chip-4 = false;
                                            root.trigger-sample-toast("warning", "Tag Removed", "Removed '120 FPS Target' chip.");
                                        }
                                    }

                                    if root.demo-chip-5: Chip {
                                        text: "Zero Bloat";
                                        has-icon: true;
                                        icon-image: @image-url("../assets/icons/shield.svg");
                                        variant: "danger";
                                        removable: true;
                                        clicked => {
                                            root.trigger-sample-toast("info", "Chip Clicked", "Selected tag: Zero Bloat");
                                        }
                                        removed => {
                                            root.demo-chip-5 = false;
                                            root.trigger-sample-toast("warning", "Tag Removed", "Removed 'Zero Bloat' chip.");
                                        }
                                    }

                                    if !root.demo-chip-1 || !root.demo-chip-2 || !root.demo-chip-3 || !root.demo-chip-4 || !root.demo-chip-5: Button {
                                        text: "Reset All Tags";
                                        variant: "ghost";
                                        clicked => {
                                            root.demo-chip-1 = true;
                                            root.demo-chip-2 = true;
                                            root.demo-chip-3 = true;
                                            root.demo-chip-4 = true;
                                            root.demo-chip-5 = true;
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 6. Data Table Pagination (Tier 2 Molecules)
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "Data Table Pagination & Stepper (Tier 2 Molecules)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "High-density navigation controls with first, previous, next, last triggers and item counter display.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                Rectangle {
                                    border-radius: Spacing.radius-md;
                                    background: Palette.bg-surface;
                                    border-width: 1px;
                                    border-color: Palette.border-subtle;

                                    VerticalLayout {
                                        padding: Spacing.space-md;

                                        Pagination {
                                            current-page <=> root.demo-page;
                                            total-pages: 12;
                                            total-items: 120;
                                            page-size: 10;
                                            page-changed(p) => {
                                                root.trigger-sample-toast("info", "Page Navigated", "Current page index set to: " + p);
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 7. Color Swatch Picker (Tier 2 Molecules)
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "Color Picker & Palette Swatches (Tier 2 Molecules)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Curated design token swatches with hex preview and active checkmark feedback.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                HorizontalLayout {
                                    alignment: start;

                                    ColorPicker {
                                        label: "Theme Accent Swatch";
                                        selected-color <=> root.demo-color;
                                        selected-hex <=> root.demo-color-hex;
                                        color-selected(col, hex-val) => {
                                            Palette.accent = col;
                                            root.accent-color-changed(hex-val);
                                            root.trigger-sample-toast("success", "App Palette Updated", "Applied " + hex-val + " across all design tokens and saved to SQLite.");
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 8. Monetization: Credit Badges & Pricing Cards (Tier 2 Molecules)
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "Pricing Cards & Usage Badges (Tier 2 Molecules)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Desktop billing primitives: High-density credit balance pill with progress bar and highlighted plan cards.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-lg;
                                    alignment: start;

                                    CreditBadge {
                                        credits: 3450;
                                        max-credits: 5000;
                                        tier-name: "PRO ACTIVE";
                                        top-up-clicked => {
                                            root.checkout-open("Micro Compute Pack", "credits", "$10");
                                        }
                                        tier-clicked => {
                                            root.checkout-open("Pro Developer License", "yearly", "$180");
                                        }
                                    }

                                    CreditBadge {
                                        credits: 120;
                                        max-credits: 1000;
                                        tier-name: "FREE TIER";
                                        is-active: false;
                                        top-up-clicked => {
                                            root.checkout-open("Micro Compute Pack", "credits", "$10");
                                        }
                                        tier-clicked => {
                                            root.checkout-open("Pro Developer License", "monthly", "$19");
                                        }
                                    }
                                }
                            }
                        }

                        // ----------------------------------------------------
                        // SUB-TAB 2: TIER 3 DESKTOP ORGANISMS & TOOLS
                        // ----------------------------------------------------
                        if root.selected-tier-tab == 2: VerticalLayout {
                            spacing: 28px;

                            // 1. Hierarchical TreeView & File Explorer
                            VerticalLayout {
                                spacing: Spacing.space-md;

                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Hierarchical File Explorer & TreeView (Tier 3 Organisms)";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-lg;
                                        font-weight: Typography.weight-semibold;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "Collapsible directory tree with sub-millisecond in-process filesystem scanning and node inspection.";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-xs;
                                        color: Palette.text-secondary;
                                    }
                                }

                                // Directory Navigation & Scanning Toolbar
                                VerticalLayout {
                                    spacing: Spacing.space-sm;

                                    // Row 1: Active Directory Path Input & Primary Actions
                                    HorizontalLayout {
                                        spacing: Spacing.space-sm;

                                        TextInputField {
                                            horizontal-stretch: 1;
                                            min-width: 150px;
                                            placeholder: "Directory path (e.g. C:/... or .)";
                                            text <=> root.tree-current-path;
                                        }

                                        Button {
                                            text: "Browse Folder...";
                                            variant: "secondary";
                                            clicked => {
                                                root.tree-browse-folder();
                                            }
                                        }

                                        Button {
                                            text: "Scan Path";
                                            variant: "primary";
                                            clicked => {
                                                root.tree-load-path(root.tree-current-path);
                                            }
                                        }
                                    }

                                    // Row 2: Quick Jump Presets (Workspace, Desktop, User Home)
                                    HorizontalLayout {
                                        spacing: Spacing.space-sm;
                                        alignment: start;

                                        Text {
                                            text: "Quick Access:";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-xs;
                                            font-weight: Typography.weight-semibold;
                                            color: Palette.text-secondary;
                                            vertical-alignment: center;
                                        }

                                        Button {
                                            text: "Workspace";
                                            variant: "ghost";
                                            clicked => {
                                                root.tree-quick-jump("workspace");
                                            }
                                        }

                                        Button {
                                            text: "Desktop";
                                            variant: "ghost";
                                            clicked => {
                                                root.tree-quick-jump("desktop");
                                            }
                                        }

                                        Button {
                                            text: "Home Directory";
                                            variant: "ghost";
                                            clicked => {
                                                root.tree-quick-jump("home");
                                            }
                                        }
                                    }
                                }

                                // Desktop 2-Column Split: TreeView on Left, Node Details Inspector on Right
                                HorizontalLayout {
                                    spacing: Spacing.space-lg;
                                    height: 380px;

                                    // Left Column: Interactive Scrollable TreeView
                                    TreeView {
                                        title: "Project Repository Tree";
                                        items: root.tree-items;
                                        selected-id <=> root.tree-selected-id;
                                        horizontal-stretch: 1;
                                        node-selected(id, label, is-folder) => {
                                            root.tree-selected-id = id;
                                            root.tree-selected-label = label;
                                            root.tree-selected-is-folder = is-folder;
                                            root.tree-node-selected(id, label, is-folder);
                                        }
                                        toggle-expand(id, expanded) => {
                                            root.tree-toggle-expand(id, expanded);
                                        }
                                    }

                                    // Right Column: Node Inspector & Filesystem Actions
                                    Rectangle {
                                        width: 320px;
                                        border-radius: Spacing.radius-lg;
                                        border-width: 1px;
                                        border-color: Palette.border-subtle;
                                        background: Palette.bg-surface;
                                        clip: true;

                                        VerticalLayout {
                                            // Header
                                            VerticalLayout {
                                                spacing: 0px;

                                                Rectangle {
                                                    height: 38px;
                                                    background: Palette.bg-card-header;

                                                    HorizontalLayout {
                                                        padding-left: Spacing.space-md;
                                                        padding-right: Spacing.space-md;
                                                        alignment: space-between;

                                                        Text {
                                                            text: "NODE INSPECTOR";
                                                            font-family: Typography.font-family;
                                                            font-size: Typography.size-xs;
                                                            font-weight: 700;
                                                            color: Palette.text-primary;
                                                            vertical-alignment: center;
                                                            letter-spacing: 0.5px;
                                                        }

                                                        Badge {
                                                            text: root.tree-selected-is-folder ? "Folder" : "File";
                                                            variant: root.tree-selected-is-folder ? "secondary" : "primary";
                                                        }
                                                    }
                                                }

                                                Rectangle {
                                                    height: 1px;
                                                    background: Palette.border-subtle;
                                                }
                                            }

                                            // Node Details Body
                                            VerticalLayout {
                                                padding: Spacing.space-md;
                                                spacing: Spacing.space-md;

                                                VerticalLayout {
                                                    spacing: 4px;
                                                    Text {
                                                        text: "Selected Node Path";
                                                        font-family: Typography.font-family;
                                                        font-size: Typography.size-xs;
                                                        color: Palette.text-secondary;
                                                    }
                                                    Text {
                                                        text: root.tree-selected-label;
                                                        font-family: Typography.font-family;
                                                        font-size: Typography.size-base;
                                                        font-weight: 700;
                                                        color: Palette.text-primary;
                                                        wrap: word-wrap;
                                                    }
                                                }

                                                Rectangle { height: 1px; background: Palette.border-subtle; }

                                                VerticalLayout {
                                                    spacing: 4px;
                                                    Text {
                                                        text: "Node Identifier (UUID / Path)";
                                                        font-family: Typography.font-family;
                                                        font-size: Typography.size-xs;
                                                        color: Palette.text-secondary;
                                                    }
                                                    Text {
                                                        text: root.tree-selected-id;
                                                        font-family: Typography.font-family;
                                                        font-size: Typography.size-xs;
                                                        color: Palette.accent;
                                                        wrap: word-wrap;
                                                    }
                                                }

                                                Rectangle { height: 1px; background: Palette.border-subtle; }

                                                VerticalLayout {
                                                    spacing: Spacing.space-sm;

                                                    Button {
                                                        text: "Scan Local Workspace";
                                                        variant: "primary";
                                                        clicked => {
                                                            root.tree-refresh-scan();
                                                        }
                                                    }

                                                    Text {
                                                        text: "Direct in-process query via std::fs with 0 child processes.";
                                                        font-family: Typography.font-family;
                                                        font-size: 11px;
                                                        color: Palette.text-secondary;
                                                        horizontal-alignment: center;
                                                        wrap: word-wrap;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 2. Enterprise Data Grid Table & SQLite CRUD Toolbar
                            VerticalLayout {
                                spacing: Spacing.space-md;

                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Enterprise Data Grid & SQLite Engine (Tier 3 Organisms)";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-lg;
                                        font-weight: Typography.weight-semibold;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "High-density desktop table with SQLite WAL persistence, live counts, and modal editing.";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-xs;
                                        color: Palette.text-secondary;
                                    }
                                }

                                // Interactive Local SQLite CRUD Toolbar
                                HorizontalLayout {
                                    alignment: space-between;

                                    // Left: Status & Count (Vertically Centered with Toolbar Buttons)
                                    VerticalLayout {
                                        alignment: center;

                                        HorizontalLayout {
                                            spacing: Spacing.space-sm;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                Badge {
                                                    text: "SQLite WAL Mode";
                                                    variant: "success";
                                                    has-dot: true;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "• " + root.db-records.length + " Total Records";
                                                    font-family: Typography.font-family;
                                                    font-size: Typography.size-xs;
                                                    color: Palette.text-secondary;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // Right: CRUD Action Buttons
                                    HorizontalLayout {
                                        spacing: Spacing.space-sm;
                                        alignment: center;

                                        Button {
                                            text: "Add Record";
                                            variant: "primary";
                                            clicked => {
                                                root.form-service = "";
                                                root.form-runtime = "";
                                                root.form-status = "Active";
                                                root.form-latency = "1.0 ms";
                                                root.is-editing-record = false;
                                                root.show-crud-modal = true;
                                            }
                                        }

                                        Button {
                                            text: root.db-selected-count > 1 ? ("Edit (" + root.db-selected-count + ")") : "Edit Selected";
                                            variant: "secondary";
                                            enabled: root.db-records.length > 0;
                                            clicked => {
                                                if root.db-selected-count > 1 {
                                                    root.show-batch-edit-modal = true;
                                                } else if root.selected-record-idx >= 0 && root.selected-record-idx < root.db-records.length {
                                                    root.form-service = root.db-records[root.selected-record-idx].service;
                                                    root.form-runtime = root.db-records[root.selected-record-idx].runtime;
                                                    root.form-status = root.db-records[root.selected-record-idx].status;
                                                    root.form-latency = root.db-records[root.selected-record-idx].latency;
                                                    root.edit-record-id = root.db-records[root.selected-record-idx].id;
                                                    root.is-editing-record = true;
                                                    root.show-crud-modal = true;
                                                }
                                            }
                                        }

                                        Button {
                                            text: root.db-selected-count > 1 ? ("Delete (" + root.db-selected-count + ")") : "Delete Selected";
                                            variant: "danger";
                                            enabled: root.db-records.length > 0;
                                            clicked => {
                                                if root.db-selected-count > 1 {
                                                    root.show-batch-delete-confirm = true;
                                                } else {
                                                    root.show-delete-confirm = true;
                                                }
                                            }
                                        }

                                        Button {
                                            text: "Reload";
                                            variant: "ghost";
                                            clicked => {
                                                root.db-refresh();
                                            }
                                        }
                                    }
                                }

                                // Batch Selection Quick-Action Bar (Fully Vertically Centered & Compact)
                                if root.db-selected-count > 0: Rectangle {
                                    height: 44px;
                                    border-radius: Spacing.radius-md;
                                    border-width: 1px;
                                    border-color: Palette.border-highlight;
                                    background: Palette.bg-highlight;

                                    HorizontalLayout {
                                        padding-left: Spacing.space-md;
                                        padding-right: Spacing.space-md;
                                        alignment: space-between;

                                        // Left: Count and Quick Status Pills (All Vertically Centered)
                                        HorizontalLayout {
                                            spacing: Spacing.space-sm;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                Badge {
                                                    text: root.db-selected-count + " Selected";
                                                    variant: "primary";
                                                    has-dot: true;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Text {
                                                    text: "Set Status:";
                                                    font-family: Typography.font-family;
                                                    font-size: Typography.size-xs;
                                                    font-weight: Typography.weight-semibold;
                                                    color: Palette.text-secondary;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            for q_st in ["Active", "Standby", "Warning", "Offline"]: VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    height: 26px;
                                                    border-radius: Spacing.radius-sm;
                                                    border-width: 1px;
                                                    border-color: Palette.border-subtle;
                                                    background: qst-touch.has-hover ? Palette.bg-surface-hover : Palette.bg-surface;

                                                    HorizontalLayout {
                                                        padding-left: 7px;
                                                        padding-right: 7px;
                                                        Text {
                                                            text: q_st;
                                                            font-family: Typography.font-family;
                                                            font-size: Typography.size-xs;
                                                            font-weight: Typography.weight-medium;
                                                            color: q_st == "Active" ? #10b981 :
                                                                   q_st == "Warning" ? #f59e0b :
                                                                   q_st == "Offline" ? #ef4444 : Palette.text-primary;
                                                            vertical-alignment: center;
                                                        }
                                                    }

                                                    qst-touch := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.db-batch-set-status(q_st);
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // Right: Batch Edit & Deselect Triggers (All Vertically Centered)
                                        HorizontalLayout {
                                            spacing: Spacing.space-sm;
                                            alignment: center;

                                            VerticalLayout {
                                                alignment: center;
                                                Button {
                                                    text: "Batch Edit (" + root.db-selected-count + ")";
                                                    variant: "secondary";
                                                    clicked => {
                                                        root.show-batch-edit-modal = true;
                                                    }
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                Button {
                                                    text: "Deselect";
                                                    variant: "ghost";
                                                    clicked => {
                                                        root.db-select-all(false);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Desktop High-Density Data Grid Table (Bound to local SQLite database)
                                DataTable {
                                    rows: root.db-records;
                                    selected-row <=> root.selected-record-idx;
                                    selected-count: root.db-selected-count;
                                    multi-select-enabled: true;
                                    row-toggle-selected(idx, is_sel) => {
                                        root.db-toggle-row-selected(idx);
                                    }
                                    select-all(c) => {
                                        root.db-select-all(c);
                                    }
                                    row-selected(idx, id) => {
                                        root.selected-record-idx = idx;
                                        root.trigger-sample-toast("info", "Record Selected", "Inspecting SQLite service: " + id);
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 3. Desktop Organisms: Modals, Dropdowns & Toasts
                            VerticalLayout {
                                spacing: Spacing.space-md;

                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Desktop Modals, Dropdowns & Notifications (Tier 3 Organisms)";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-lg;
                                        font-weight: Typography.weight-semibold;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "Top-level composite window dialogs, floating toasts, and opaque dropdowns.";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-xs;
                                        color: Palette.text-secondary;
                                    }
                                }

                                // Row 1: Modal + Dropdown
                                HorizontalLayout {
                                    spacing: Spacing.space-md;
                                    alignment: start;

                                    Button {
                                        text: "Launch Modal Dialog";
                                        variant: "primary";
                                        clicked => {
                                            root.show-modal = true;
                                        }
                                    }

                                    Dropdown {
                                        width: 260px;
                                        placeholder: "Select Density Profile...";
                                    }
                                }

                                // Row 2: Toast Notification Triggers
                                HorizontalLayout {
                                    spacing: Spacing.space-md;
                                    alignment: start;

                                    Button {
                                        text: "Trigger Success Toast";
                                        variant: "secondary";
                                        clicked => {
                                            root.trigger-sample-toast("success", "Build Succeeded", "Native Rust binary optimized and signed.");
                                        }
                                    }

                                    Button {
                                        text: "Trigger Warning Toast";
                                        variant: "danger";
                                        clicked => {
                                            root.trigger-sample-toast("danger", "Process Warning", "Hardware GPU buffer spike detected.");
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 4. Thermal Receipt & Document Canvas
                            VerticalLayout {
                                spacing: Spacing.space-md;

                                VerticalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "Thermal Receipt & Document Canvas (Tier 3 Organisms)";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-lg;
                                        font-weight: Typography.weight-semibold;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "High-contrast document layout with itemization, procedural barcodes, and tax breakdowns.";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-xs;
                                        color: Palette.text-secondary;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-xl;
                                    alignment: start;

                                    // Left: Realistic Thermal Canvas
                                    ReceiptCanvas { }

                                    // Right: Industrial ESC/POS Hardware & Spooler Pipeline
                                    Rectangle {
                                        width: 360px;
                                        border-radius: Spacing.radius-lg;
                                        border-width: 1px;
                                        border-color: Palette.border-subtle;
                                        background: Palette.bg-surface;

                                        VerticalLayout {
                                            padding: Spacing.space-lg;
                                            spacing: Spacing.space-md;

                                            Text {
                                                text: "INDUSTRIAL ESC/POS THERMAL PIPELINE";
                                                font-family: Typography.font-family;
                                                font-size: Typography.size-xs;
                                                font-weight: 700;
                                                color: Palette.text-primary;
                                                letter-spacing: 0.5px;
                                            }

                                            Text {
                                                text: "How production POS printing works end-to-end: Native Rust formats raw ESC/POS byte streams (init, alignment, auto-cut) dispatched directly to hardware with zero web overhead.";
                                                font-family: Typography.font-family;
                                                font-size: Typography.size-xs;
                                                color: Palette.text-secondary;
                                                wrap: word-wrap;
                                            }

                                            Rectangle { height: 1px; background: Palette.border-subtle; }

                                            // Connection Channels
                                            VerticalLayout {
                                                spacing: 6px;

                                                HorizontalLayout {
                                                    alignment: space-between;
                                                    Text { text: "Network TCP/IP:"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                                    Badge { text: "Port 9100 RAW"; variant: "accent"; }
                                                }
                                                HorizontalLayout {
                                                    alignment: space-between;
                                                    Text { text: "USB / Serial:"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                                    Badge { text: "Virtual COM3"; variant: "neutral"; }
                                                }
                                                HorizontalLayout {
                                                    alignment: space-between;
                                                    Text { text: "Windows Spooler:"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                                    Badge { text: "winspool.drv RAW"; variant: "success"; has-dot: true; }
                                                }
                                                HorizontalLayout {
                                                    alignment: space-between;
                                                    Text { text: "Auto-Guillotine Cutter:"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                                    Badge { text: "Full Cut (GS V 0)"; variant: "neutral"; }
                                                }
                                            }

                                            Rectangle { height: 1px; background: Palette.border-subtle; }

                                            // Interactive Spooler Triggers
                                            VerticalLayout {
                                                spacing: Spacing.space-sm;

                                                Button {
                                                    text: "Spool Test Print Job";
                                                    variant: "primary";
                                                    clicked => {
                                                        root.trigger-sample-toast("success", "Thermal Print Spooled", "Generated receipts/ORD-SAMPLE.txt and sent ESC/POS cut job.");
                                                    }
                                                }

                                                Button {
                                                    text: "Isolated POS Showcase";
                                                    variant: "secondary";
                                                    clicked => {
                                                        root.trigger-sample-toast("info", "Run Isolated POS Demo", "Execute 'cargo run --example pos_terminal' in terminal.");
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 5. Command Palette & Spotlight Launcher (Tier 3 Organisms)
                            VerticalLayout {
                                spacing: Spacing.space-sm;
                                Text {
                                    text: "Command Palette & Spotlight Launcher (Tier 3 Organisms)";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                }
                                Text {
                                    text: "Keyboard-driven spotlight launcher with quick action dispatch, search query filtering, and category grouping.";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                }

                                HorizontalLayout {
                                    spacing: Spacing.space-md;
                                    alignment: start;

                                    Button {
                                        text: "Open Spotlight Command Palette (Ctrl+K)";
                                        variant: "primary";
                                        clicked => {
                                            root.show-command-palette = true;
                                        }
                                    }

                                    Button {
                                        text: "Toggle Theme via Action";
                                        variant: "secondary";
                                        clicked => {
                                            root.command-palette-action("toggle-theme");
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Palette.border-subtle; }

                            // 6. Licensing & Checkout Engine (Tier 3 Organisms)
                            VerticalLayout {
                                spacing: Spacing.space-md;

                                PlanSelector {
                                    active-plan-id: root.checkout-active-plan;
                                    plan-chosen(id, cycle, price) => {
                                        root.checkout-open(id == "pro" ? "Pro Developer License" : id == "enterprise" ? "Enterprise Studio License" : "Community Starter", cycle, price);
                                    }
                                    buy-credits-pack(credits, price) => {
                                        root.checkout-open(credits + " Compute Units Pack", "credits", price);
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 1: LIVE FEED SYSTEM
                    // ==========================================
                    if root.selected-tab == 1: VerticalLayout {
                        spacing: Spacing.space-md;

                        LiveFeedView {
                            items: root.live-feed-items;
                            is-paused: root.is-feed-paused;
                            toggle-pause => { root.toggle-feed-pause(); }
                            clear-feed => { root.clear-feed(); }
                        }
                    }

                    // ==========================================
                    // TAB 2: DESIGN TOKENS EXPLORER (Full Restoration)
                    // ==========================================
                    if root.selected-tab == 2: VerticalLayout {
                        spacing: Spacing.space-lg;

                        Text {
                            text: "Color Palette Tokens";
                            font-family: Typography.font-family;
                            font-size: Typography.size-lg;
                            font-weight: Typography.weight-semibold;
                            color: Palette.text-primary;
                        }

                        // Color Swatches Grid
                        HorizontalLayout {
                            spacing: Spacing.space-md;

                            Rectangle {
                                height: 90px;
                                border-radius: Spacing.radius-md;
                                border-width: 1px;
                                border-color: Palette.border-strong;
                                background: Palette.bg-canvas;
                                VerticalLayout {
                                    padding: Spacing.space-sm;
                                    alignment: space-between;
                                    Text { text: "bg-canvas"; font-size: Typography.size-sm; color: Palette.text-primary; font-weight: Typography.weight-bold; }
                                    Text { text: Palette.sepia-mode ? "#F4ECD8" : (Palette.dark-mode ? "#0F172A" : "#F8FAFC"); font-size: Typography.size-xs; color: Palette.text-secondary; }
                                }
                            }

                            Rectangle {
                                height: 90px;
                                border-radius: Spacing.radius-md;
                                border-width: 1px;
                                border-color: Palette.border-strong;
                                background: Palette.bg-surface;
                                VerticalLayout {
                                    padding: Spacing.space-sm;
                                    alignment: space-between;
                                    Text { text: "bg-surface"; font-size: Typography.size-sm; color: Palette.text-primary; font-weight: Typography.weight-bold; }
                                    Text { text: Palette.sepia-mode ? "#FBF7EE" : (Palette.dark-mode ? "#1E293B" : "#FFFFFF"); font-size: Typography.size-xs; color: Palette.text-secondary; }
                                }
                            }

                            Rectangle {
                                height: 90px;
                                border-radius: Spacing.radius-md;
                                background: Palette.accent;
                                VerticalLayout {
                                    padding: Spacing.space-sm;
                                    alignment: space-between;
                                    Text { text: "accent"; font-size: Typography.size-sm; color: #ffffff; font-weight: Typography.weight-bold; }
                                    Text { text: "#3B82F6"; font-size: Typography.size-xs; color: #ffffffcc; }
                                }
                            }

                            Rectangle {
                                height: 90px;
                                border-radius: Spacing.radius-md;
                                background: Palette.danger;
                                VerticalLayout {
                                    padding: Spacing.space-sm;
                                    alignment: space-between;
                                    Text { text: "danger"; font-size: Typography.size-sm; color: #ffffff; font-weight: Typography.weight-bold; }
                                    Text { text: "#EF4444"; font-size: Typography.size-xs; color: #ffffffcc; }
                                }
                            }

                            Rectangle {
                                height: 90px;
                                border-radius: Spacing.radius-md;
                                background: Palette.success;
                                VerticalLayout {
                                    padding: Spacing.space-sm;
                                    alignment: space-between;
                                    Text { text: "success"; font-size: Typography.size-sm; color: #ffffff; font-weight: Typography.weight-bold; }
                                    Text { text: "#10B981"; font-size: Typography.size-xs; color: #ffffffcc; }
                                }
                            }
                        }

                        // Typography Scale Demo
                        VerticalLayout {
                            spacing: Spacing.space-sm;

                            Text {
                                text: "Typography Scales (HiDPI Native Calibrated)";
                                font-family: Typography.font-family;
                                font-size: Typography.size-lg;
                                font-weight: Typography.weight-semibold;
                                color: Palette.text-primary;
                            }

                            Rectangle {
                                border-radius: Spacing.radius-md;
                                border-width: 1px;
                                border-color: Palette.border-subtle;
                                background: Palette.bg-surface;

                                VerticalLayout {
                                    padding: Spacing.space-md;
                                    spacing: Spacing.space-sm;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Headline 2XL (28px)"; font-family: Typography.font-family; font-size: Typography.size-2xl; font-weight: Typography.weight-bold; color: Palette.text-primary; }
                                        Text { text: "Typography.size-2xl • 700"; font-size: Typography.size-sm; color: Palette.text-secondary; vertical-alignment: center; }
                                    }
                                    Rectangle { height: 1px; background: Palette.border-subtle; }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Title XL (23px)"; font-family: Typography.font-family; font-size: Typography.size-xl; font-weight: Typography.weight-semibold; color: Palette.text-primary; }
                                        Text { text: "Typography.size-xl • 600"; font-size: Typography.size-sm; color: Palette.text-secondary; vertical-alignment: center; }
                                    }
                                    Rectangle { height: 1px; background: Palette.border-subtle; }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Section LG (19px)"; font-family: Typography.font-family; font-size: Typography.size-lg; font-weight: Typography.weight-medium; color: Palette.text-primary; }
                                        Text { text: "Typography.size-lg • 500"; font-size: Typography.size-sm; color: Palette.text-secondary; vertical-alignment: center; }
                                    }
                                    Rectangle { height: 1px; background: Palette.border-subtle; }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Body Base (16px)"; font-family: Typography.font-family; font-size: Typography.size-base; color: Palette.text-primary; }
                                        Text { text: "Typography.size-base • 400"; font-size: Typography.size-sm; color: Palette.text-secondary; vertical-alignment: center; }
                                    }
                                    Rectangle { height: 1px; background: Palette.border-subtle; }

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text { text: "Caption SM (15px)"; font-family: Typography.font-family; font-size: Typography.size-sm; color: Palette.text-secondary; }
                                        Text { text: "Typography.size-sm • 400"; font-size: Typography.size-sm; color: Palette.text-secondary; vertical-alignment: center; }
                                    }
                                }
                            }
                        }

                        // Spacing Scale Tokens
                        VerticalLayout {
                            spacing: Spacing.space-sm;

                            Text {
                                text: "Layout Grid & Spacing Scales";
                                font-family: Typography.font-family;
                                font-size: Typography.size-lg;
                                font-weight: Typography.weight-semibold;
                                color: Palette.text-primary;
                            }

                            HorizontalLayout {
                                spacing: Spacing.space-md;

                                Rectangle {
                                    height: 50px;
                                    border-radius: Spacing.radius-md;
                                    border-width: 1px;
                                    border-color: Palette.border-subtle;
                                    background: Palette.bg-surface;
                                    HorizontalLayout {
                                        padding: Spacing.space-sm;
                                        alignment: center;
                                        Text { text: "space-xs: 4px"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                    }
                                }
                                Rectangle {
                                    height: 50px;
                                    border-radius: Spacing.radius-md;
                                    border-width: 1px;
                                    border-color: Palette.border-subtle;
                                    background: Palette.bg-surface;
                                    HorizontalLayout {
                                        padding: Spacing.space-sm;
                                        alignment: center;
                                        Text { text: "space-sm: 8px"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                    }
                                }
                                Rectangle {
                                    height: 50px;
                                    border-radius: Spacing.radius-md;
                                    border-width: 1px;
                                    border-color: Palette.border-subtle;
                                    background: Palette.bg-surface;
                                    HorizontalLayout {
                                        padding: Spacing.space-sm;
                                        alignment: center;
                                        Text { text: "space-md: 16px"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                    }
                                }
                                Rectangle {
                                    height: 50px;
                                    border-radius: Spacing.radius-md;
                                    border-width: 1px;
                                    border-color: Palette.border-subtle;
                                    background: Palette.bg-surface;
                                    HorizontalLayout {
                                        padding: Spacing.space-sm;
                                        alignment: center;
                                        Text { text: "space-lg: 24px"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                    }
                                }
                                Rectangle {
                                    height: 50px;
                                    border-radius: Spacing.radius-md;
                                    border-width: 1px;
                                    border-color: Palette.border-subtle;
                                    background: Palette.bg-surface;
                                    HorizontalLayout {
                                        padding: Spacing.space-sm;
                                        alignment: center;
                                        Text { text: "space-xl: 32px"; font-size: Typography.size-xs; color: Palette.text-secondary; }
                                    }
                                }
                            }
                        }
                    }

                    // ==========================================
                    // TAB 3: SYSTEM CONFIG (Theme Toggle Moved Here!)
                    // ==========================================
                    if root.selected-tab == 3: VerticalLayout {
                        spacing: Spacing.space-lg;

                        Text {
                            text: "Appearance & Environment";
                            font-family: Typography.font-family;
                            font-size: Typography.size-lg;
                            font-weight: Typography.weight-semibold;
                            color: Palette.text-primary;
                        }

                        // Clean, Perfectly-Aligned Dark Mode Setting Row (Persistent SQLite Preference)
                        Rectangle {
                            border-radius: Spacing.radius-lg;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            background: Palette.bg-surface;

                            HorizontalLayout {
                                padding: Spacing.space-lg;
                                alignment: space-between;

                                // Left: Setting Info (Constrained and stretchable)
                                HorizontalLayout {
                                    spacing: Spacing.space-md;
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    min-width: 0px;

                                    Image {
                                        source: @image-url("../assets/icons/tokens.svg");
                                        width: 24px;
                                        height: 24px;
                                        colorize: Palette.accent;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        spacing: 2px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        min-width: 0px;

                                        HorizontalLayout {
                                            spacing: Spacing.space-sm;
                                            alignment: start;

                                            Text {
                                                text: "Display Mode (Theme Preference)";
                                                font-family: Typography.font-family;
                                                font-size: Typography.size-base;
                                                font-weight: Typography.weight-semibold;
                                                color: Palette.text-primary;
                                            }

                                            Badge {
                                                text: "Persistent SQLite";
                                                variant: "success";
                                                has-dot: true;
                                            }
                                        }

                                        Text {
                                            text: Palette.sepia-mode ? ("Active: Vintage Sepia Theme (#F4ECD8) • " + root.theme-mode-status) :
                                                  Palette.dark-mode ? ("Active: Slate Dark Theme (#0F172A) • " + root.theme-mode-status) :
                                                  ("Active: Clean Light Theme (#F8FAFC) • " + root.theme-mode-status);
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-sm;
                                            color: Palette.text-secondary;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                // Right: Actions (Auto-detect OS + 3-Mode Theme Selector)
                                HorizontalLayout {
                                    spacing: Spacing.space-sm;
                                    alignment: center;

                                    Button {
                                        text: "Auto-detect OS";
                                        variant: "ghost";
                                        clicked => {
                                            root.theme-reset-os();
                                        }
                                    }

                                    // 3-Mode Segmented Theme Switcher
                                    Rectangle {
                                        height: 36px;
                                        border-radius: Spacing.radius-md;
                                        border-width: 1px;
                                        border-color: Palette.border-subtle;
                                        background: Palette.bg-subtle;

                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;
                                            alignment: center;

                                            // Light Mode
                                            Rectangle {
                                                height: 30px;
                                                border-radius: Spacing.radius-sm;
                                                background: (!Palette.dark-mode && !Palette.sepia-mode) ? Palette.accent :
                                                            light-touch.has-hover ? Palette.bg-surface-hover : transparent;

                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    alignment: center;
                                                    Text {
                                                        text: "Light";
                                                        font-family: Typography.font-family;
                                                        font-size: Typography.size-xs;
                                                        font-weight: Typography.weight-semibold;
                                                        color: (!Palette.dark-mode && !Palette.sepia-mode) ? #ffffff : Palette.text-primary;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                light-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.theme-set-mode("light");
                                                    }
                                                }
                                            }

                                            // Dark Mode
                                            Rectangle {
                                                height: 30px;
                                                border-radius: Spacing.radius-sm;
                                                background: Palette.dark-mode ? Palette.accent :
                                                            dark-touch.has-hover ? Palette.bg-surface-hover : transparent;

                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    alignment: center;
                                                    Text {
                                                        text: "Dark";
                                                        font-family: Typography.font-family;
                                                        font-size: Typography.size-xs;
                                                        font-weight: Typography.weight-semibold;
                                                        color: Palette.dark-mode ? #ffffff : Palette.text-primary;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                dark-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.theme-set-mode("dark");
                                                    }
                                                }
                                            }

                                            // Sepia Mode
                                            Rectangle {
                                                height: 30px;
                                                border-radius: Spacing.radius-sm;
                                                background: Palette.sepia-mode ? Palette.accent :
                                                            sepia-touch.has-hover ? Palette.bg-surface-hover : transparent;

                                                HorizontalLayout {
                                                    padding-left: 12px;
                                                    padding-right: 12px;
                                                    alignment: center;
                                                    Text {
                                                        text: "Sepia";
                                                        font-family: Typography.font-family;
                                                        font-size: Typography.size-xs;
                                                        font-weight: Typography.weight-semibold;
                                                        color: Palette.sepia-mode ? #ffffff : Palette.text-primary;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                sepia-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.theme-set-mode("sepia");
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        Divider { text: "NATIVE DESKTOP SHORTCUT & LAUNCHER"; }

                        // Native Desktop Shortcut Row
                        Rectangle {
                            border-radius: Spacing.radius-lg;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            background: Palette.bg-surface;

                            HorizontalLayout {
                                padding: Spacing.space-lg;
                                alignment: space-between;

                                // Left: Setting Info (Constrained and stretchable)
                                HorizontalLayout {
                                    spacing: Spacing.space-md;
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    min-width: 0px;

                                    Image {
                                        source: @image-url("../assets/icons/file.svg");
                                        width: 24px;
                                        height: 24px;
                                        colorize: Palette.accent;
                                        vertical-alignment: center;
                                    }

                                    VerticalLayout {
                                        spacing: 3px;
                                        alignment: center;
                                        horizontal-stretch: 1;
                                        min-width: 0px;

                                        HorizontalLayout {
                                            spacing: Spacing.space-sm;
                                            alignment: start;

                                            Text {
                                                text: "Desktop Shortcut Launcher";
                                                font-family: Typography.font-family;
                                                font-size: Typography.size-base;
                                                font-weight: Typography.weight-semibold;
                                                color: Palette.text-primary;
                                                vertical-alignment: center;
                                            }

                                            Badge {
                                                text: root.shortcut-installed ? "Installed" : "Not Created";
                                                variant: root.shortcut-installed ? "success" : "neutral";
                                                has-dot: root.shortcut-installed;
                                            }
                                        }

                                        Text {
                                            text: root.shortcut-installed 
                                                ? "Active shortcut at: " + root.shortcut-path
                                                : "Creates a native Shell .lnk on user's Desktop with embedded application icon.";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-xs;
                                            color: Palette.text-secondary;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                }

                                // Right: Actions (Pinned width, never pushed out)
                                HorizontalLayout {
                                    spacing: Spacing.space-sm;
                                    alignment: end;
                                    horizontal-stretch: 0;
                                    min-width: 140px;

                                    if !root.shortcut-installed: Button {
                                        text: "Create Shortcut";
                                        variant: "primary";
                                        clicked => {
                                            root.create-desktop-shortcut();
                                        }
                                    }

                                    if root.shortcut-installed: Button {
                                        text: "Remove Shortcut";
                                        variant: "danger";
                                        clicked => {
                                            root.remove-desktop-shortcut();
                                        }
                                    }
                                }
                            }
                        }

                        Divider { text: "360° HARDWARE DIAGNOSTICS & GPU TELEMETRY"; }

                        // Hardware Diagnostics Header Bar with Live Refresh Action
                        HorizontalLayout {
                            alignment: space-between;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text {
                                    text: "System Hardware & GPU Capabilities";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-lg;
                                    font-weight: Typography.weight-semibold;
                                    color: Palette.text-primary;
                                    overflow: elide;
                                }
                                Text {
                                    text: "Real-time native Windows registry and kernel telemetry • Direct query";
                                    font-family: Typography.font-family;
                                    font-size: Typography.size-xs;
                                    color: Palette.text-secondary;
                                    wrap: word-wrap;
                                }
                            }

                            HorizontalLayout {
                                spacing: Spacing.space-sm;
                                alignment: end;

                                Badge {
                                    text: "RSS: " + root.hw-app-memory;
                                    variant: "success";
                                    has-dot: true;
                                }

                                Button {
                                    text: "Resample";
                                    variant: "secondary";
                                    clicked => {
                                        root.refresh-hardware-diagnostics();
                                    }
                                }
                            }
                        }

                        // 4-Card 360° Telemetry Grid (2 rows x 2 columns, fluid and responsive)
                        // Row 1: CPU Subsystem & Physical RAM
                        HorizontalLayout {
                            spacing: Spacing.space-md;

                            // Card 1: CPU Subsystem
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Palette.border-subtle;
                                background: Palette.bg-surface;

                                VerticalLayout {
                                    padding: Spacing.space-md;
                                    spacing: Spacing.space-sm;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "CPU Subsystem";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-base;
                                            font-weight: Typography.weight-semibold;
                                            color: Palette.text-primary;
                                        }
                                        Badge {
                                            text: root.hw-cpu-cores + " Cores";
                                            variant: "primary";
                                            has-dot: true;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: root.hw-cpu-brand;
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-sm;
                                            font-weight: Typography.weight-bold;
                                            color: Palette.text-primary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "Clock: " + root.hw-cpu-freq + " • Host: " + root.hw-host-name;
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-xs;
                                            color: Palette.text-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "Uptime: " + root.hw-uptime;
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-xs;
                                            color: Palette.text-secondary;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 4px;
                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: "CPU Active Utilization";
                                                font-size: Typography.size-xs;
                                                color: Palette.text-secondary;
                                            }
                                            Text {
                                                text: Math.round(root.hw-cpu-usage) + "%";
                                                font-size: Typography.size-xs;
                                                font-weight: Typography.weight-semibold;
                                                color: Palette.accent;
                                            }
                                        }
                                        ProgressBar {
                                            progress: root.hw-cpu-usage / 100.0;
                                            bar-height: 6px;
                                            variant: root.hw-cpu-usage > 80.0 ? "danger" : "primary";
                                        }
                                    }
                                }
                            }

                            // Card 2: Physical RAM Memory Engine
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Palette.border-subtle;
                                background: Palette.bg-surface;

                                VerticalLayout {
                                    padding: Spacing.space-md;
                                    spacing: Spacing.space-sm;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Memory (RAM) Engine";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-base;
                                            font-weight: Typography.weight-semibold;
                                            color: Palette.text-primary;
                                        }
                                        Badge {
                                            text: root.hw-ram-total + " Total";
                                            variant: "success";
                                            has-dot: true;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: root.hw-ram-used + " in use (" + Math.round(root.hw-ram-usage) + "%)";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-sm;
                                            font-weight: Typography.weight-bold;
                                            color: Palette.text-primary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.hw-ram-free + " available";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-xs;
                                            color: Palette.text-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "Zero GC paging • Pure native RSS";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-xs;
                                            color: Palette.text-secondary;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 4px;
                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: "System Memory Allocated";
                                                font-size: Typography.size-xs;
                                                color: Palette.text-secondary;
                                            }
                                            Text {
                                                text: Math.round(root.hw-ram-usage) + "%";
                                                font-size: Typography.size-xs;
                                                font-weight: Typography.weight-semibold;
                                                color: Palette.success;
                                            }
                                        }
                                        ProgressBar {
                                            progress: root.hw-ram-usage / 100.0;
                                            bar-height: 6px;
                                            variant: "success";
                                        }
                                    }
                                }
                            }
                        }

                        // Row 2: GPU Capabilities & OS Subsystem
                        HorizontalLayout {
                            spacing: Spacing.space-md;

                            // Card 3: Dedicated GPU & Graphics Pipeline
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Palette.border-subtle;
                                background: Palette.bg-surface;

                                VerticalLayout {
                                    padding: Spacing.space-md;
                                    spacing: Spacing.space-sm;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Discrete GPU & Graphics";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-base;
                                            font-weight: Typography.weight-semibold;
                                            color: Palette.text-primary;
                                        }
                                        Badge {
                                            text: "RTX Accelerated";
                                            variant: "primary";
                                            has-dot: true;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: root.hw-gpu-name;
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-sm;
                                            font-weight: Typography.weight-bold;
                                            color: Palette.text-primary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.hw-gpu-secondary;
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-xs;
                                            color: Palette.text-secondary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: root.hw-graphics-backend;
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-xs;
                                            color: Palette.accent;
                                            wrap: word-wrap;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.space-xs;
                                        Badge { text: "120 FPS Target"; variant: "neutral"; }
                                        Badge { text: "Raytracing Ready"; variant: "neutral"; }
                                    }
                                }
                            }

                            // Card 4: Operating System & Host Environment
                            Rectangle {
                                horizontal-stretch: 1;
                                border-radius: Spacing.radius-lg;
                                border-width: 1px;
                                border-color: Palette.border-subtle;
                                background: Palette.bg-surface;

                                VerticalLayout {
                                    padding: Spacing.space-md;
                                    spacing: Spacing.space-sm;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "OS & Runtime Kernel";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-base;
                                            font-weight: Typography.weight-semibold;
                                            color: Palette.text-primary;
                                        }
                                        Badge {
                                            text: "x86_64 Native";
                                            variant: "success";
                                            has-dot: true;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: root.hw-os-name;
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-sm;
                                            font-weight: Typography.weight-bold;
                                            color: Palette.text-primary;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "DirectX 12 Swapchain • WAL SQLite Active";
                                            font-family: Typography.font-family;
                                            font-size: Typography.size-xs;
                                            color: Palette.text-secondary;
                                            wrap: word-wrap;
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: Spacing.space-xs;
                                        Badge { text: "Zero Webview"; variant: "neutral"; }
                                        Badge { text: "ACID Safe"; variant: "neutral"; }
                                    }
                                }
                            }
                        }

                        // Distribution Export Card
                        Rectangle {
                            border-radius: Spacing.radius-lg;
                            border-width: 1px;
                            border-color: Palette.border-subtle;
                            background: Palette.bg-surface;

                            HorizontalLayout {
                                padding: Spacing.space-lg;
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: 2px;
                                    alignment: center;

                                    Text {
                                        text: "Package Standalone Distribution";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-base;
                                        font-weight: Typography.weight-semibold;
                                        color: Palette.text-primary;
                                    }
                                    Text {
                                        text: "Compiles complete library into a single optimized 7.7 MB executable.";
                                        font-family: Typography.font-family;
                                        font-size: Typography.size-sm;
                                        color: Palette.text-secondary;
                                    }
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    Button {
                                        text: "Export Binary (.exe)";
                                        variant: "primary";
                                        clicked => {
                                            root.show-modal = true;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // 3. Native Desktop Status Bar (Window Footer)
    StatusBar {
        status-text: "All Systems Operational";
        status-level: "success";
        branch-name: "main";
        encoding: "UTF-8";
        engine-info: root.hw-graphics-backend + " • 120 FPS";
        memory-info: root.hw-app-memory + " RSS";
        status-clicked => {
            root.trigger-sample-toast("info", "Engine Status", "Direct3D 12 Hardware V-Sync 120 FPS active.");
        }
        branch-clicked => {
            root.trigger-sample-toast("info", "VCS Branch", "Connected to Git repository on main branch.");
        }
    }
}
}

    // Modal Dialog Overlay
    ModalDialog {
        is-open <=> root.show-modal;
        title: "Export Native Component Library";
        message: "Are you sure you want to package this desktop design system? All component tokens, atomic styles, and molecules will be compiled into your standalone distribution.";
        confirm-text: "Export Standalone";
        confirm-variant: "primary";
        confirmed => {
            root.trigger-sample-toast("success", "Export Completed", "Distribution binary verified and packaged in target/release/.");
        }
    }

    // Floating Toast Notification (Anchored to bottom-right corner)
    toast := ToastNotification {
        x: root.width - self.width - 24px;
        y: root.height - self.height - 38px;
        is-open <=> root.toast-open;
        title: root.toast-title;
        message: root.toast-message;
        status: root.toast-status;
    }

    // Command Palette Spotlight Launcher Overlay
    CommandPalette {
        width: 100%;
        height: 100%;
        is-open <=> root.show-command-palette;
        commands: root.palette-commands;
        search-changed(q) => {
            root.command-palette-search(q);
        }
        command-selected(id) => {
            root.command-palette-action(id);
        }
        closed => {
            root.command-palette-search("");
        }
    }

    // CRUD Add/Edit Record Modal
    CrudModal {
        is-open <=> root.show-crud-modal;
        title: root.is-editing-record ? ("Edit Record #" + root.edit-record-id) : "Add Service to SQLite Database";
        submit-text: root.is-editing-record ? "Update Record" : "Save to SQLite";
        service-val <=> root.form-service;
        runtime-val <=> root.form-runtime;
        status-val <=> root.form-status;
        latency-val <=> root.form-latency;
        saved(srv, run, st, lat) => {
            if root.is-editing-record {
                root.db-update-record(root.edit-record-id, srv, run, st, lat);
            } else {
                root.db-add-record(srv, run, st, lat);
            }
        }
    }

    // Delete Confirmation Modal
    ModalDialog {
        is-open <=> root.show-delete-confirm;
        title: "Confirm Deletion";
        message: "Are you sure you want to permanently delete the selected service record from your local SQLite database?";
        confirm-text: "Delete Record";
        confirm-variant: "danger";
        confirmed => {
            root.db-delete-selected(root.selected-record-idx);
        }
    }

    // Batch Edit Modal (Full application overlay, centered and opaque)
    BatchEditModal {
        width: 100%;
        height: 100%;
        is-open <=> root.show-batch-edit-modal;
        selected-count: root.db-selected-count;
        saved(apply_run, run, apply_st, st, apply_lat, lat) => {
            root.db-batch-update(apply_run, run, apply_st, st, apply_lat, lat);
        }
    }

    // Batch Delete Confirmation Modal
    ModalDialog {
        is-open <=> root.show-batch-delete-confirm;
        title: "Confirm Batch Deletion";
        message: "Are you sure you want to permanently delete all " + root.db-selected-count + " selected service records from your local SQLite database? This batch operation cannot be undone.";
        confirm-text: "Delete " + root.db-selected-count + " Records";
        confirm-variant: "danger";
        confirmed => {
            root.db-batch-delete();
        }
    }

    // Checkout Modal (Desktop Payment, UPI QR & Crypto Overlay)
    CheckoutModal {
        width: 100%;
        height: 100%;
        is-open <=> root.checkout-modal-open;
        plan-title: root.checkout-plan-title;
        plan-price: root.checkout-plan-price;
        billing-cycle: root.checkout-billing-cycle;
        crypto-address: "0x742d35Cc6634C0532925a3b844Bc454e4438f44e";
        upi-vpa: "desktop.system@okhdfcbank";
        upi-amount-inr: root.checkout-plan-price == "$180" ? "₹14,999.00" :
                        root.checkout-plan-price == "$19" ? "₹1,599.00" :
                        root.checkout-plan-price == "$828" ? "₹68,999.00" : "₹899.00";
        active-payment-tab <=> root.checkout-payment-tab;
        crypto-step: root.checkout-crypto-step;
        crypto-blocks: root.checkout-crypto-blocks;
        status-feedback: root.checkout-feedback;
        timer-text: root.checkout-timer-text;

        launch-card-checkout => {
            root.trigger-sample-toast("info", "Browser Checkout Redirect", "Opened https://checkout.stripe.com/pay/... in default system browser.");
        }
        copy-text(text) => {
            root.trigger-sample-toast("success", "Copied to Clipboard", text);
        }
        simulate-upi-payment => {
            root.checkout-feedback = "UPI Webhook Received: ₹ Verified via HDFC Bank!";
            root.checkout-active-plan = "pro";
            root.trigger-sample-toast("success", "Payment Confirmed", "UPI transaction finalized. License key issued.");
        }
        simulate-crypto-payment => {
            root.checkout-crypto-step = 3;
            root.checkout-crypto-blocks = 12;
            root.checkout-feedback = "12/12 Blocks Finalized on Polygon. Transaction Confirmed!";
            root.checkout-active-plan = "pro";
            root.trigger-sample-toast("success", "Blockchain Confirmed", "USDT transaction verified on-chain. License activated.");
        }
        complete-activation => {
            root.checkout-modal-open = false;
            root.trigger-sample-toast("success", "License Activated", "Ed25519 signature verified offline. Stored in SQLite WAL.");
        }
        closed => {
            root.checkout-modal-open = false;
            root.checkout-crypto-step = 0;
            root.checkout-crypto-blocks = 0;
            root.checkout-feedback = "";
        }
    }
}
